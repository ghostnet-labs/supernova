{
  "apiVersion": "monitoring.coreos.com/v1",
  "kind": "PrometheusRule",
  "metadata": {
    "name": "ci-platform",
    "namespace": "monitoring",
    "labels": {
      "release": "ci-monitoring"
    }
  },
  "spec": {
    "groups": [
      {
        "name": "ci-platform",
        "rules": [
          {
            "alert": "CIClusterNodeUnavailable",
            "expr": "kube_node_status_condition{condition=\"Ready\",status=\"true\"} == 0",
            "for": "5m",
            "labels": {
              "severity": "critical"
            },
            "annotations": {
              "summary": "CI Kubernetes node is not Ready"
            }
          },
          {
            "alert": "CIRunnerPending",
            "expr": "sum(kube_pod_status_phase{namespace=\"arc-runners\",phase=\"Pending\"}) > 0",
            "for": "10m",
            "labels": {
              "severity": "warning"
            },
            "annotations": {
              "summary": "Runner pods are pending; check resource quota and node capacity"
            }
          },
          {
            "alert": "CIDiskLow",
            "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\",mountpoint=\"/\"} / node_filesystem_size_bytes < 0.15",
            "for": "5m",
            "labels": {
              "severity": "warning"
            },
            "annotations": {
              "summary": "Guest filesystem has less than 15% free"
            }
          },
          {
            "alert": "CIPodOOMKilled",
            "expr": "max by(namespace,pod)(kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\",namespace=~\"arc-.*|monitoring\"} * on(namespace,pod,container) group_left() increase(kube_pod_container_status_restarts_total[10m])) > 0",
            "for": "0m",
            "labels": {
              "severity": "warning"
            },
            "annotations": {
              "summary": "A CI or monitoring container was OOM killed"
            }
          },
          {
            "alert": "CIScrapeFailed",
            "expr": "up == 0",
            "for": "5m",
            "labels": {
              "severity": "warning"
            },
            "annotations": {
              "summary": "A CI metric target is unavailable"
            }
          },
          {
            "alert": "CIMetricsCollectionFailed",
            "expr": "ci_metrics_collection_success == 0",
            "for": "5m",
            "labels": {
              "severity": "warning"
            },
            "annotations": {
              "summary": "CI host or GitHub collector cannot refresh its measurements"
            }
          },
          {
            "alert": "CIMetricsCollectionStale",
            "expr": "time() - ci_metrics_last_success_timestamp_seconds > 600",
            "for": "5m",
            "labels": {
              "severity": "warning"
            },
            "annotations": {
              "summary": "CI collector has not completed a successful collection in ten minutes"
            }
          },
          {
            "alert": "CIHostCollectorFailed",
            "expr": "node_scrape_collector_success == 0",
            "for": "5m",
            "labels": {
              "severity": "warning"
            },
            "annotations": {
              "summary": "A node exporter collector failed; host metrics are incomplete"
            }
          },
          {
            "alert": "CIConventionalRunnerOffline",
            "expr": "ci_github_runner_online == 0",
            "for": "10m",
            "labels": {
              "severity": "warning"
            },
            "annotations": {
              "summary": "A registered conventional GitHub runner has been offline for ten minutes"
            }
          },
          {
            "alert": "CIHostMemoryLow",
            "expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes < 0.10",
            "for": "5m",
            "labels": {
              "severity": "warning"
            },
            "annotations": {
              "summary": "A Linux host has less than 10 percent available memory"
            }
          },
          {
            "alert": "CIArcRunnerFailed",
            "expr": "gha_controller_failed_ephemeral_runners > 0",
            "for": "5m",
            "labels": {
              "severity": "warning"
            },
            "annotations": {
              "summary": "ARC has failed ephemeral runners"
            }
          }
        ]
      }
    ]
  }
}
