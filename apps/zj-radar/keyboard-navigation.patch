+        r#"printf '\033]0;stock-title\007'"#,
+    ]);
+    session.run_action(&["write", "13"]);
+    let native_visible = session.wait_until(std::time::Duration::from_secs(5), |s| {
+        s.pane_list_json().contains("stock-title")
+    });
+    assert!(native_visible, "terminal OSC title never reached Zellij");
+
+    let running = format!(
+        r#"{{"v":1,"source":"codex","pane":{{"type":"terminal","id":{pane_id}}},"status":"running","repo":"setup"}}"#
+    );
+    session.pipe_status(&running);
+    std::thread::sleep(std::time::Duration::from_millis(400));
+    let panes = session.pane_list_json();
+    assert!(
+        panes.contains("stock-title"),
+        "default radar config must not replace the stock OSC title; panes: {panes}"
