@@ -0,0 +1,367 @@
+//! Focus-aware keyboard navigation for the selectable radar rail.
+//!
+//! Zellij broadcasts \`MessagePlugin\` keybinds to every radar instance, one per
+//! tab. Only the instance in the active tab may act: when its rail is focused,
+//! it resolves the adjacent tab's matching radar pane; otherwise it resolves
+//! vertical movement directly among terminal panes, excluding the rail.
+
+use std::collections::BTreeMap;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Direction {
+    Previous,
+    Next,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Action {
+    FocusPluginPane {
+        tab_position: usize,
+        plugin_id: u32,
+    },
+    FocusTerminalPane(u32),
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Pane {
+    pub tab_position: usize,
+    pub id: u32,
+    pub plugin_url: Option<String>,
+    pub is_plugin: bool,
+    pub focused: bool,
+    pub selectable: bool,
+    pub floating: bool,
+    pub suppressed: bool,
+    pub x: usize,
+    pub y: usize,
+    pub rows: usize,
+    pub columns: usize,
+}
+
+#[derive(Default)]
+pub(crate) struct Navigation {
+    own_plugin_id: Option<u32>,
+    own_tab_position: Option<usize>,
+    own_focused: bool,
+    active_override: Option<bool>,
+    radar_by_tab: BTreeMap<usize, u32>,
+    panes: Vec<Pane>,
+}
+
+impl Navigation {
+    pub(crate) fn set_own_plugin_id(&mut self, plugin_id: u32) {
+        self.own_plugin_id = Some(plugin_id);
+    }
+
+    #[cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+    pub(crate) fn set_own_focused(&mut self, focused: bool) {
+        self.own_focused = focused;
+    }
+
+    #[cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+    pub(crate) fn own_tab_position(&self) -> Option<usize> {
+        self.own_tab_position
+    }
+
+    /// Whether this plugin instance's tab currently contains any terminal
+    /// pane. `None` means the instance could not locate itself in the latest
+    /// global manifest, which must not be mistaken for an empty tab.
+    pub(crate) fn own_tab_has_terminal(&self) -> Option<bool> {
+        let own_tab = self.own_tab_position?;
+        Some(
+            self.panes
+                .iter()
+                .any(|pane| pane.tab_position == own_tab && !pane.is_plugin),
+        )
+    }
+
+    #[cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+    pub(crate) fn set_active_override(&mut self, active: bool) {
+        self.active_override = Some(active);
+    }
+
+    pub(crate) fn update_panes(&mut self, panes: &[Pane]) {
+        self.own_tab_position = None;
+        self.own_focused = false;
+        self.radar_by_tab.clear();
+        self.panes = panes.to_vec();
+
+        let Some(own_id) = self.own_plugin_id else { return };
+        let Some(own) = panes
+            .iter()
+            .find(|pane| pane.is_plugin && pane.id == own_id)
+        else {
+            return;
+        };
+        let Some(own_url) = own.plugin_url.as_deref() else { return };
+
+        self.own_tab_position = Some(own.tab_position);
+        self.own_focused = own.focused;
+        self.radar_by_tab.extend(
+            panes
+                .iter()
+                .filter(|pane| {
+                    pane.is_plugin && pane.plugin_url.as_deref() == Some(own_url)
+                })
+                .map(|pane| (pane.tab_position, pane.id)),
+        );
+    }
+
+    pub(crate) fn action(
+        &self,
+        tabs: &[(usize, bool)],
+        direction: Direction,
+    ) -> Option<Action> {
+        let own_tab = self.own_tab_position?;
+        let own_index = tabs
+            .iter()
+            .position(|&(position, _)| position == own_tab)?;
+        let reports_active = tabs[own_index].1;
+        match self.active_override {
+            Some(false) => return None,
+            Some(true) => {}
+            None if !reports_active => return None,
+            None => {}
+        }
+
+        if !self.own_focused {
+            return self
+                .vertical_terminal_target(own_tab, direction)
+                .map(Action::FocusTerminalPane);
+        }
+        if tabs.len() < 2 {
+            return None;
+        }
+
+        let target_index = match direction {
+            Direction::Previous => own_index.checked_sub(1).unwrap_or(tabs.len() - 1),
+            Direction::Next => (own_index + 1) % tabs.len(),
+        };
+        let target_position = tabs[target_index].0;
+        self.radar_by_tab
+            .get(&target_position)
+            .copied()
+            .map(|plugin_id| Action::FocusPluginPane {
+                tab_position: target_position,
+                plugin_id,
+            })
+    }
+
+    fn vertical_terminal_target(&self, tab_position: usize, direction: Direction) -> Option<u32> {
+        let current = self.panes.iter().find(|pane| {
+            pane.tab_position == tab_position
+                && !pane.is_plugin
+                && pane.focused
+                && pane.selectable
+                && !pane.floating
+                && !pane.suppressed
+        })?;
+        let overlaps = |candidate: &Pane| {
+            candidate.x < current.x + current.columns
+                && current.x < candidate.x + candidate.columns
+        };
+        let adjacent = |candidate: &Pane| match direction {
+            Direction::Previous => candidate.y + candidate.rows == current.y,
+            Direction::Next => candidate.y == current.y + current.rows,
+        };
+
+        self.panes
+            .iter()
+            .filter(|pane| {
+                pane.tab_position == tab_position
+                    && !pane.is_plugin
+                    && pane.id != current.id
+                    && pane.selectable
+                    && !pane.floating
+                    && !pane.suppressed
+                    && adjacent(pane)
+                    && overlaps(pane)
+            })
+            .max_by_key(|pane| {
+                std::cmp::min(current.x + current.columns, pane.x + pane.columns)
+                    - std::cmp::max(current.x, pane.x)
+            })
+            .map(|pane| pane.id)
+    }
+
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn radar(tab_position: usize, id: u32, focused: bool) -> Pane {
+        Pane {
+            tab_position,
+            id,
+            plugin_url: Some("file:/radar.wasm".to_string()),
+            is_plugin: true,
+            focused,
+            selectable: true,
+            floating: false,
+            suppressed: false,
+            x: 0,
+            y: 0,
+            rows: 20,
+            columns: 32,
+        }
+    }
+
+    fn terminal(tab_position: usize, id: u32, focused: bool, y: usize) -> Pane {
+        Pane {
+            tab_position,
+            id,
+            plugin_url: None,
+            is_plugin: false,
+            focused,
+            selectable: true,
+            floating: false,
+            suppressed: false,
+            x: 32,
+            y,
+            rows: 10,
+            columns: 48,
+        }
+    }
+
+    #[test]
+    fn focused_active_radar_cycles_and_wraps() {
+        let mut nav = Navigation::default();
+        nav.set_own_plugin_id(11);
+        nav.update_panes(&[
+            radar(0, 10, false),
+            radar(1, 11, true),
+            radar(2, 12, false),
+        ]);
+        let tabs = [(0, false), (1, true), (2, false)];
+
+        assert_eq!(
+            nav.action(&tabs, Direction::Previous),
+            Some(Action::FocusPluginPane {
+                tab_position: 0,
+                plugin_id: 10,
+            })
+        );
+        assert_eq!(
+            nav.action(&tabs, Direction::Next),
+            Some(Action::FocusPluginPane {
+                tab_position: 2,
+                plugin_id: 12,
+            })
+        );
+
+        let wrapped_tabs = [(0, true), (1, false), (2, false)];
+        nav.set_own_plugin_id(10);
+        nav.update_panes(&[
+            radar(0, 10, true),
+            radar(1, 11, false),
+            radar(2, 12, false),
+        ]);
+        assert_eq!(
+            nav.action(&wrapped_tabs, Direction::Previous),
+            Some(Action::FocusPluginPane {
+                tab_position: 2,
+                plugin_id: 12,
+            })
+        );
+    }
+
+    #[test]
+    fn background_instance_is_inert_and_content_moves_between_terminals() {
+        let tabs = [(0, true), (1, false)];
+        let mut nav = Navigation::default();
+        nav.set_own_plugin_id(11);
+        nav.update_panes(&[radar(0, 10, false), radar(1, 11, true)]);
+        assert_eq!(nav.action(&tabs, Direction::Next), None);
+
+        nav.set_own_plugin_id(10);
+        nav.update_panes(&[
+            radar(0, 10, false),
+            radar(1, 11, false),
+            terminal(0, 20, true, 0),
+            terminal(0, 21, false, 10),
+        ]);
+        assert_eq!(
+            nav.action(&tabs, Direction::Next),
+            Some(Action::FocusTerminalPane(21))
+        );
+        assert_eq!(nav.action(&tabs, Direction::Previous), None);
+    }
+
+    #[test]
+    fn explicit_handoff_ignores_stale_runtime_active_flags() {
+        let stale_tabs = [(0, true), (1, false), (2, false)];
+        let mut target = Navigation::default();
+        target.set_own_plugin_id(11);
+        target.update_panes(&[
+            radar(0, 10, false),
+            radar(1, 11, true),
+            radar(2, 12, false),
+        ]);
+        target.set_active_override(true);
+        assert_eq!(
+            target.action(&stale_tabs, Direction::Next),
+            Some(Action::FocusPluginPane {
+                tab_position: 2,
+                plugin_id: 12,
+            })
+        );
+
+        let mut source = Navigation::default();
+        source.set_own_plugin_id(10);
+        source.update_panes(&[
+            radar(0, 10, true),
+            radar(1, 11, false),
+            radar(2, 12, false),
+        ]);
+        source.set_active_override(false);
+        assert_eq!(source.action(&stale_tabs, Direction::Next), None);
+    }
+
+    #[test]
+    fn vertical_navigation_ignores_radar_and_non_adjacent_terminals() {
+        let tabs = [(0, true)];
+        let mut nav = Navigation::default();
+        nav.set_own_plugin_id(10);
+        nav.update_panes(&[
+            radar(0, 10, false),
+            terminal(0, 20, true, 0),
+            terminal(0, 21, false, 15),
+        ]);
+
+        assert_eq!(nav.action(&tabs, Direction::Previous), None);
+        assert_eq!(nav.action(&tabs, Direction::Next), None);
+    }
+
+    #[test]
+    fn unrelated_plugins_and_incomplete_topology_are_ignored() {
+        let tabs = [(0, true), (1, false)];
+        let mut nav = Navigation::default();
+        nav.set_own_plugin_id(10);
+        let mut status_bar = radar(1, 99, false);
+        status_bar.plugin_url = Some("zellij:status-bar".to_string());
+        nav.update_panes(&[radar(0, 10, true), status_bar]);
+        assert_eq!(nav.action(&tabs, Direction::Next), None);
+
+        nav.update_panes(&[]);
+        assert_eq!(nav.action(&tabs, Direction::Next), None);
+    }
+
+    #[test]
+    fn own_tab_terminal_presence_requires_locating_this_plugin() {
+        let mut nav = Navigation::default();
+        nav.set_own_plugin_id(10);
+
+        nav.update_panes(&[radar(1, 11, false), terminal(1, 20, true, 0)]);
+        assert_eq!(nav.own_tab_has_terminal(), None);
+
+        nav.update_panes(&[radar(0, 10, true)]);
+        assert_eq!(nav.own_tab_has_terminal(), Some(false));
+
+        nav.update_panes(&[
+            radar(0, 10, false),
+            terminal(0, 20, true, 0),
+            terminal(1, 21, true, 0),
+        ]);
+        assert_eq!(nav.own_tab_has_terminal(), Some(true));
+    }
+}
