+/// A radar instance is a real pane, so without plugin cooperation Zellij keeps
+/// a tab alive after its last terminal closes. The instance must retire itself
+/// after the guarded one-second confirmation interval, allowing Zellij to
+/// remove that tab and focus the remaining one naturally.
+#[test]
+#[ignore = "e2e: requires zellij + built wasm; run via `just test-e2e`"]
+fn closing_the_last_terminal_closes_its_radar_only_tab() {
+    use std::collections::HashSet;
+    use std::time::Duration;
+
+    let wasm = plugin_wasm_path();
+    let temp_home = pre_grant_permissions(&wasm);
+    let session_name = format!("zjr_empty_tab_{}", std::process::id());
+    let layout = two_sidebar_tabs_layout(&wasm);
+    let session = ZellijSession::start(&session_name, &layout, &wasm, temp_home);
+
+    let pane1 = session.discover_terminal_pane_id();
+    let mut pane2 = pane1;
+    for _ in 0..10 {
+        session.run_action(&["go-to-tab", "2"]);
+        std::thread::sleep(Duration::from_millis(300));
+        let candidate = session.discover_terminal_pane_id();
+        if candidate != pane1 {
+            pane2 = candidate;
+            break;
+        }
+    }
+    assert_ne!(pane1, pane2, "could not discover tab two's terminal pane");
+
+    let on_tab1 = session.wait_until(Duration::from_secs(8), |s| {
+        s.run_action(&["go-to-tab", "1"]);
+        s.dump_screen().contains(&format!("ZPID={pane1}"))
+    });
+    assert!(
+        on_tab1,
+        "could not return to tab one before closing its terminal"
+    );
+
+    let pane1_target = format!("terminal_{pane1}");
+    session.run_action(&["close-pane", "--pane-id", &pane1_target]);
+
+    let tab_closed = session.wait_until(Duration::from_secs(8), |s| {
+        if !s.dump_screen().contains(&format!("ZPID={pane2}")) {
+            return false;
+        }
+        let panes: serde_json::Value = match serde_json::from_str(&s.pane_list_json()) {
+            Ok(panes) => panes,
+            Err(_) => return false,
