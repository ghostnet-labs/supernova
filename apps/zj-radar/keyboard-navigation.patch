@@ -0,0 +1,375 @@
+//! Composite Codex state + base-name titles for terminal panes.
+//!
+//! Zellij exposes only the resolved pane title, not whether it came from an
+//! explicit rename or the terminal's OSC title.  This reconciler therefore
+//! treats the current title as the source of truth, strips only prefixes that
+//! zj-radar or Codex owns, and remembers the resulting base while the pane is
+//! tracked.  It is pure: the runtime turns returned [`PaneRename`] values into
+//! host effects, and the wasm adapter is the only layer that calls Zellij.
+
+use crate::kind::Kind;
+use crate::payload;
+use crate::status::{GlyphSet, Status};
+use std::collections::{BTreeMap, BTreeSet};
+
+// Retained in release WASM so setup verification can distinguish the pane-title
+// build from an older navigation-only artifact without loading it into Zellij.
+#[used]
+static PANE_TITLES_MARKER: [u8; 23] = *b"zj_radar.pane_titles.v1";
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Pane {
+    pub id: u32,
+    pub tab_position: usize,
+    pub title: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct CodexState {
+    pub pane_id: u32,
+    pub status: Status,
+    pub repo: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct PaneRename {
+    pub pane_id: u32,
+    pub name: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct PendingRename {
+    observed: String,
+    requested: String,
+}
+
+#[derive(Default)]
+pub(crate) struct PaneTitles {
+    panes: BTreeMap<u32, Pane>,
+    managed_bases: BTreeMap<u32, String>,
+    pending: BTreeMap<u32, PendingRename>,
+}
+
+impl PaneTitles {
+    /// Replace the local plugin instance's topology view.  Every radar instance
+    /// receives every pane manifest; retaining only the instance's own tab is
+    /// what makes one host rename per pane rather than one per session tab.
+    pub(crate) fn update_manifest(&mut self, own_tab_position: Option<usize>, panes: Vec<Pane>) {
+        self.panes = own_tab_position
+            .map(|own| {
+                panes
+                    .into_iter()
+                    .filter(|pane| pane.tab_position == own)
+                    .map(|pane| (pane.id, pane))
+                    .collect()
+            })
+            .unwrap_or_default();
+        let live: BTreeSet<u32> = self.panes.keys().copied().collect();
+        self.managed_bases
+            .retain(|pane_id, _| live.contains(pane_id));
+        self.pending.retain(|pane_id, _| live.contains(pane_id));
+    }
+
+    /// Produce only titles that differ from what Zellij currently reports.
+    /// Running animation is driven by the runtime's 10 Hz visual clock; other
+    /// states naturally settle after their single semantic edge.
+    pub(crate) fn reconcile(
+        &mut self,
+        states: Vec<CodexState>,
+        glyphs: GlyphSet,
+        animation_frame: u64,
+    ) -> Vec<PaneRename> {
+        let states: BTreeMap<u32, CodexState> = states
+            .into_iter()
+            .map(|state| (state.pane_id, state))
+            .collect();
+        let mut renames = Vec::new();
+
+        for (&pane_id, pane) in &self.panes {
+            if self
+                .pending
+                .get(&pane_id)
+                .is_some_and(|pending| pane.title == pending.requested)
+            {
+                self.pending.remove(&pane_id);
+            }
+            if let Some(state) = states.get(&pane_id) {
+                let observed_base = base_title(&pane.title);
+                let base = if observed_base.is_empty() {
+                    self.managed_bases
+                        .get(&pane_id)
+                        .cloned()
+                        .or_else(|| nonempty(&state.repo))
+                        .unwrap_or_else(|| "codex".to_string())
+                } else {
+                    observed_base
+                };
+                let desired = composite_title(state, &base, glyphs, animation_frame);
+                self.managed_bases.insert(pane_id, base);
+                let already_requested = self.pending.get(&pane_id).is_some_and(|pending| {
+                    pending.observed == pane.title && pending.requested == desired
+                });
+                if desired != pane.title && !already_requested {
+                    self.pending.insert(
+                        pane_id,
+                        PendingRename {
+                            observed: pane.title.clone(),
+                            requested: desired.clone(),
+                        },
+                    );
+                    renames.push(PaneRename {
+                        pane_id,
+                        name: desired,
+                    });
+                }
+            } else if let Some(previous_base) = self.managed_bases.remove(&pane_id) {
+                // The Codex observation disappeared (eg. prompt return).  Undo
+                // only our decoration; a simultaneous manual rename wins.
+                let observed_base = base_title(&pane.title);
+                let base = if observed_base.is_empty() {
+                    previous_base
+                } else {
+                    observed_base
+                };
+                if base != pane.title {
+                    self.pending.insert(
+                        pane_id,
+                        PendingRename {
+                            observed: pane.title.clone(),
+                            requested: base.clone(),
+                        },
+                    );
+                    renames.push(PaneRename {
+                        pane_id,
+                        name: base,
+                    });
+                }
+            }
+        }
+        renames
+    }
+}
+
+fn nonempty(value: &str) -> Option<String> {
+    let value = value.trim();
+    (!value.is_empty()).then(|| value.to_string())
+}
+
+fn composite_title(
+    state: &CodexState,
+    base: &str,
+    glyphs: GlyphSet,
+    animation_frame: u64,
+) -> String {
+    let glyph = if state.status == Status::Running {
+        crate::render::running_glyph(Kind::Codex, animation_frame)
+    } else {
+        state.status.glyph_for(glyphs)
+    };
+    let base = payload::sanitize(base, payload::MAX_TAB_NAME_CHARS);
+    let base: String = base
+        .chars()
+        .take(payload::MAX_TAB_NAME_CHARS.saturating_sub(2))
+        .collect();
+    format!("{glyph} {base}")
+}
+
+/// Recover the stable part of a resolved Zellij pane title.  This is also the
+/// restart migration: a plugin instance that first sees `⠋ pane5` recovers
+/// `pane5` without persisting a second title schema.
+fn base_title(title: &str) -> String {
+    let mut title = payload::sanitize(title, payload::MAX_TAB_NAME_CHARS)
+        .trim()
+        .to_string();
+
+    // Codex's native needs-input titles use this shape.  Prefer the repository
+    // suffix; without one, fall back to the status payload's repo in reconcile.
+    if (title.starts_with("[ ! ]") || title.starts_with("[ . ]"))
+        && title.contains("Action Required")
+    {
+        title = title
+            .rsplit_once('|')
+            .map(|(_, suffix)| suffix.trim().to_string())
+            .unwrap_or_default();
+    }
+
+    while let Some(stripped) = strip_owned_glyph(&title) {
+        title = stripped.to_string();
+    }
+
+    if is_pane_placeholder(&title) {
+        String::new()
+    } else {
+        title.trim().to_string()
+    }
+}
+
+fn strip_owned_glyph(title: &str) -> Option<&str> {
+    let first = title.chars().next()?;
+    let owned = ('\u{2800}'..='\u{28ff}').contains(&first)
+        || Status::ALL.iter().any(|status| {
+            status.glyph_for(GlyphSet::Plain) == first || status.glyph_for(GlyphSet::Nerd) == first
+        });
+    if !owned {
+        return None;
+    }
+    let rest = &title[first.len_utf8()..];
+    rest.chars()
+        .next()
+        .is_some_and(char::is_whitespace)
+        .then(|| rest.trim_start())
+}
+
+fn is_pane_placeholder(title: &str) -> bool {
+    title
+        .strip_prefix("Pane #")
+        .is_some_and(|n| !n.is_empty() && n.chars().all(|c| c.is_ascii_digit()))
+}
