+        let Some(panes) = panes.as_array() else {
+            return false;
+        };
+        let tabs: HashSet<String> = panes
+            .iter()
+            .filter_map(|pane| {
+                pane.get("tab_id")
+                    .or_else(|| pane.get("tab_position"))
+                    .or_else(|| pane.get("tab_name"))
+                    .map(ToString::to_string)
+            })
+            .collect();
+        tabs.len() == 1
+    });
+    assert!(
+        tab_closed,
+        "radar must retire so closing tab one's last terminal removes the tab; panes: {}",
+        session.pane_list_json()
+    );
