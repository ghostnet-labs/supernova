#!/bin/sh
# Block commits without a successful scan. setup.sh --fix sets core.hooksPath.
if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit: python3 is not installed; required secret scan cannot run" >&2
  exit 1
fi
hook_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) || exit 1
repo_dir=$(git rev-parse --show-toplevel) || exit 1
# Keep terms listed in the untracked .local/denylist out of the commit.
"$hook_dir/check-denylist" --staged || exit 1
# Use the installed hook's implementation, never executable content from index.
exec python3 -I -S "$hook_dir/../dotfiles/lib/toolbox_secrets.py" --staged "$repo_dir"
