#!/bin/sh
# Block commits that add secrets. Enable with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; secret scan skipped" >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --log-level warn --verbose
