#!/bin/sh
# Check the first line of every commit this push adds, as the pull request check
# does: clean cherry-picks and reverts, most rebase steps, and am skip the
# commit-msg hook. Enable with: git config core.hooksPath .githooks
check="$(dirname "$0")/../.github/scripts/check_pr.sh"
[ -x "$check" ] || exit 0
# Commits on a remote-tracking branch are not checked again. With none fetched,
# the whole history, older than these rules, would be.
if [ -z "$(git for-each-ref --count=1 --format=x refs/remotes)" ]; then
  echo "pre-push: commit messages not checked; run git fetch first" >&2
  exit 0
fi
status=0
while read -r _ local_sha remote_ref remote_sha; do
  case $remote_ref in refs/heads/*) ;; *) continue ;; esac # tags and other refs
  case $local_sha in *[!0]*) ;; *) continue ;; esac        # branch deletion
  # The remote's old tip counts as checked when this clone has it.
  if git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    "$check" --commits "$local_sha" --not --remotes "$remote_sha" </dev/null || status=1
  else
    "$check" --commits "$local_sha" --not --remotes </dev/null || status=1
  fi
done
exit $status
