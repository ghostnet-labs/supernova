# Copy to .local/.env.zsh, or run ./setup.sh --fix to generate it.

# Personal setup:
WORK_ENV=false

# Work setup with an overlay checkout that holds JOB/ (see README "Work overlays"):
# WORK_ENV=true
# JOB=acme
# WORK_ROOT=/absolute/path/to/overlay-checkout

# Optional: keep forwarded SSH authentication working in existing tmux panes
# after reconnecting to this machine.
# export SETUP_FORWARDED_SSH_AGENT_LINK="$HOME/.ssh/agent.sock"
