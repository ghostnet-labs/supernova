#!/usr/bin/env bash
# toolbox: agents usage macos | Manage the menu bar app showing Codex and Claude plan usage.
# toolbox-args: [--status|--start|--stop|--install|--uninstall]
# toolbox-example: codex-bal-bar --status
# toolbox-example: codex-bal-bar --start
# toolbox-example: codex-bal-bar --install
# Build, install, and manage the Codex Balance menu bar app.

set -euo pipefail

readonly app_name="Codex Balance"
readonly executable="CodexBalBar"
readonly agent_label="local.codex-bal-bar"

usage() {
  printf '%s\n' 'Usage:
  codex-bal-bar [ACTION]

Description:
  Manage the Codex Balance menu bar app, which shows how much of the Codex and
  Claude plan limits is used in the menu bar and a usage panel when clicked.
  Install builds the app from apps/codex-bal-bar and registers a login agent.
  The Claude tab reads plan limits and usage credits, such as an Enterprise
  monthly spend limit, with Claude Code'\''s login, and token use from its
  session logs. With no ACTION, show the current status.

Options:
  --install       Build and install the app, then start it now and at every login.
  --start         Start the installed app after quitting it from the menu.
  --stop          Stop the app until the next login or --start.
  --status        Show install, login agent, running state, and credit price (default).
  --uninstall     Stop the app and remove it and its saved Claude token history.
  -h, --help      Show this help message and exit.

Examples:
  codex-bal-bar --install
  CODEX_BAL_BAR_CREDIT_USD=0.01 codex-bal-bar --install
  codex-bal-bar
  codex-bal-bar --stop
  codex-bal-bar --uninstall

Environment:
  CODEX_BIN                  Codex executable for the app (default: codex in PATH).
  CODEX_BAL_BAR_INTERVAL     Codex refresh interval in seconds, minimum 60 (default: 300).
  CODEX_BAL_BAR_CREDIT_USD   US dollars per Codex credit, to show Codex credits as dollars.
                             --install keeps the last value when unset; empty removes it.
                             To set it on every machine, export it from a work overlay'\''s
                             zshrc.zsh, so each install records it.
  CODEX_BAL_BAR_APP_DIR      Install directory (default: ~/Applications).'
}

action="--status"
if (($# > 1)); then
  usage >&2
  exit 2
fi
if (($# == 1)); then
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --install | --start | --stop | --status | --uninstall) action="$1" ;;
    *)
      printf 'error: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
fi

if [[ "$(uname -s)" != Darwin ]]; then
  printf 'error: codex-bal-bar requires macOS\n' >&2
  exit 1
fi

readonly source_dir="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../../apps/codex-bal-bar" && pwd)"
readonly app_dir="${CODEX_BAL_BAR_APP_DIR:-$HOME/Applications}"
readonly app_path="$app_dir/$app_name.app"
readonly agent_plist="$HOME/Library/LaunchAgents/$agent_label.plist"
readonly domain="gui/$(id -u)"
readonly support_dir="$HOME/Library/Application Support/$app_name"

require() {
  local command
  for command in "$@"; do
    if ! command -v "$command" >/dev/null 2>&1; then
      printf 'error: required command not found: %s\n' "$command" >&2
      exit 1
    fi
  done
}

xml_escape() {
  local value="${1//&/&amp;}"
  value="${value//</&lt;}"
  printf '%s' "${value//>/&gt;}"
}

agent_loaded() {
  launchctl print "$domain/$agent_label" >/dev/null 2>&1
}

# bootout returns before launchd removes the service, and a kickstart in that window starts nothing.
stop_agent() {
  agent_loaded || return 0
  launchctl bootout "$domain/$agent_label" 2>/dev/null || true
  local _
  for _ in {1..100}; do
    agent_loaded || return 0
    sleep 0.1
  done
  printf 'warning: launchd has not removed %s yet\n' "$agent_label" >&2
}

start_agent() {
  if agent_loaded; then
    launchctl kickstart "$domain/$agent_label"
  else
    launchctl bootstrap "$domain" "$agent_plist"
  fi
}

build_app() {
  local bundle="$1"
  mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources"
  cp "$source_dir/Info.plist" "$bundle/Contents/Info.plist"
  swiftc -O -parse-as-library -swift-version 5 \
    -target "$(uname -m)-apple-macos14.0" \
    -o "$bundle/Contents/MacOS/$executable" \
    "$source_dir/CodexBalBar.swift"
  codesign --force --sign - "$bundle" >/dev/null 2>&1
}

write_agent_plist() {
  local codex_path="$1" credit_usd="$2"
  local interval="${CODEX_BAL_BAR_INTERVAL:-300}"
  local credit_entry=""
  if [[ -n "$credit_usd" ]]; then
    credit_entry="
		<key>CODEX_BAL_BAR_CREDIT_USD</key>
		<string>$(xml_escape "$credit_usd")</string>"
  fi
  mkdir -p "${agent_plist%/*}"
  printf '%s\n' "<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">
<plist version=\"1.0\">
<dict>
	<key>Label</key>
	<string>$agent_label</string>
	<key>ProgramArguments</key>
	<array>
		<string>$(xml_escape "$app_path/Contents/MacOS/$executable")</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CODEX_BIN</key>
		<string>$(xml_escape "$codex_path")</string>
		<key>CODEX_BAL_BAR_INTERVAL</key>
		<string>$(xml_escape "$interval")</string>${credit_entry}
		<key>PATH</key>
		<string>$(xml_escape "${codex_path%/*}"):/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>" >"$agent_plist"
  plutil -lint "$agent_plist" >/dev/null
}

install_app() {
  require swiftc codesign launchctl plutil python3
  # Kept from the last install unless set; set it empty to remove it.
  local credit_usd="${CODEX_BAL_BAR_CREDIT_USD-$(plutil -extract EnvironmentVariables.CODEX_BAL_BAR_CREDIT_USD raw "$agent_plist" 2>/dev/null || true)}"
  if [[ -n "$credit_usd" && ! "$credit_usd" =~ ^[0-9]*\.?[0-9]+$ ]]; then
    printf 'error: CODEX_BAL_BAR_CREDIT_USD must be a number: %s\n' "$credit_usd" >&2
    exit 2
  fi
  local codex_path="${CODEX_BIN:-$(command -v codex || true)}"
  if [[ -z "$codex_path" || ! -x "$codex_path" ]]; then
    printf 'error: codex not found; install it or set CODEX_BIN\n' >&2
    exit 1
  fi

  # Global so the EXIT trap can still see it after this function returns.
  build_root="$(mktemp -d "${TMPDIR:-/tmp}/codex-bal-bar.XXXXXX")"
  trap 'rm -rf -- "$build_root"' EXIT
  printf '→ Building %s\n' "$app_name"
  build_app "$build_root/$app_name.app"

  restore_claude_statusline
  rm -f -- "$support_dir/claude-rate-limits.json"
  stop_agent
  mkdir -p "$app_dir"
  rm -rf -- "$app_path"
  mv "$build_root/$app_name.app" "$app_path"
  write_agent_plist "$codex_path" "$credit_usd"
  start_agent
  printf '✓ Installed %s and started it at login: %s\n' "$app_name" "$app_path"
}

# Older versions wrapped Claude Code's status line to capture plan limits;
# put back the status line they replaced.
restore_claude_statusline() {
  python3 "$source_dir/claude-statusline.py" ||
    printf 'warning: could not restore the Claude Code status line\n' >&2
}

show_status() {
  local state="not loaded"
  local credit_usd=""
  if agent_loaded; then
    state="$(launchctl print "$domain/$agent_label" | awk -F' = ' '/^\tstate = / {print $2; exit}')"
  fi
  if [[ -f "$agent_plist" ]]; then
    credit_usd="$(plutil -extract EnvironmentVariables.CODEX_BAL_BAR_CREDIT_USD raw "$agent_plist" 2>/dev/null || true)"
  fi
  printf 'App:          %s\n' "$([[ -d "$app_path" ]] && printf '%s' "$app_path" || printf 'not installed')"
  printf 'Login agent:  %s\n' "$([[ -f "$agent_plist" ]] && printf '%s' "$agent_plist" || printf 'not registered')"
  printf 'State:        %s\n' "${state:-unknown}"
  if [[ -n "$credit_usd" ]]; then
    printf 'Credit price: $%s per Codex credit\n' "$credit_usd"
  else
    printf 'Credit price: not set (Codex shows plain credits)\n'
  fi
}

case "$action" in
  --install) install_app ;;
  --start)
    if [[ ! -f "$agent_plist" ]]; then
      printf 'error: not installed; run codex-bal-bar --install\n' >&2
      exit 1
    fi
    start_agent
    ;;
  --stop) stop_agent ;;
  --status) show_status ;;
  --uninstall)
    stop_agent
    restore_claude_statusline
    rm -f -- "$agent_plist"
    rm -rf -- "$support_dir" "$app_path"
    printf '✓ Removed %s\n' "$app_name"
    ;;
esac
