        prog="codex-sessions",
        description="List, inspect, and resume local Codex sessions in their recorded working directories.",
        epilog=(
            "Examples:\n"
            "  codex-sessions\n"
            "  codex-sessions --watch --limit 20\n"
            "  codex-sessions --tui\n"
            "  codex-sessions --json --live --all\n"
            "  codex-sessions --jump SESSION_ID\n\n"
            "Environment:\n"
            "  CODEX_HOME             Override Codex home (default: ~/.codex)\n"
            "  CODEX_SESSIONS_LINKS=0 Disable resume links"
        ),
        formatter_class=lambda prog: argparse.RawDescriptionHelpFormatter(prog, max_help_position=32),
    )
    parser.add_argument("-l", "--limit", metavar="COUNT", help="Number of sessions to show (default: 10).")
    parser.add_argument("--all", action="store_true", help="Include subagent rollouts.")
    parser.add_argument("-v", "--verbose", action="store_true", help="Show full session details.")
    parser.add_argument("--json", action="store_true", help="Emit collected session data as JSON.")
    parser.add_argument("--stream-json", action="store_true", help="Stream versioned JSON snapshots, including all history and archives (default interval: 5).")
    parser.add_argument("--live", action="store_true", help="Include only sessions held open by a local Codex process.")
    parser.add_argument("--jump", metavar="SESSION_ID", help="Show a live session's exact Ghostty window, tab, and pane, or resume it.")
    parser.add_argument("--no-links", action="store_true", help="Render plain IDs instead of resume links.")
    parser.add_argument("-w", "--watch", action="store_true", help="Refresh in a resize-safe terminal screen.")
    parser.add_argument("--tui", action="store_true", help="Browse live and historical user/Codex messages interactively.")
    parser.add_argument("-n", "--interval", metavar="SECONDS", help="Watch refresh interval (default: 2).")
    parser.add_argument("--install-resume-handler", action="store_true", help="Install the macOS codex-resume:// handler.")
    parser.add_argument("--force", action="store_true", help="Replace the installed handler (install only).")
    return parser


def print_usage(stream: TextIO = sys.stdout) -> None:
    build_help_parser().print_help(file=stream)


def positive_integer(option: str, value: Optional[str]) -> int:
    if value is None or not re.fullmatch(r"[1-9][0-9]*", value):
        raise UsageError(f"Error: {option} requires a positive integer")
    return int(value)


def parse_report_options(argv: list[str]) -> ReportOptions:
    options = ReportOptions()
    display_args: list[str] = []
    index = 0
    while index < len(argv):
        argument = argv[index]
        if argument in {"-l", "--limit"}:
            value = argv[index + 1] if index + 1 < len(argv) else None
            options.limit = positive_integer(argument, value)
            display_args.extend((argument, value or ""))
            index += 2
        elif argument == "--all":
            options.include_subagents = True
            display_args.append(argument)
            index += 1
        elif argument in {"-v", "--verbose"}:
            options.verbose = True
            display_args.append(argument)
            index += 1
        elif argument == "--json":
            options.json_output = True
            display_args.append(argument)
            index += 1
        elif argument == "--stream-json":
            options.stream_json = True
            index += 1
        elif argument == "--live":
            options.live_only = True
            display_args.append(argument)
            index += 1
        elif argument == "--jump":
            raise UsageError("--jump is a standalone action and cannot be combined with report options")
        elif argument == "--no-links":
            options.no_links = True
            display_args.append(argument)
            index += 1
        elif argument in {"-w", "--watch"}:
            options.watch = True
            index += 1
        elif argument == "--tui":
            options.tui = True
            index += 1
        elif argument in {"-n", "--interval"}:
            value = argv[index + 1] if index + 1 < len(argv) else None
            options.interval = positive_integer(argument, value)
            index += 2
        elif argument in {"-h", "--help"}:
            print_usage()
            raise SystemExit(0)
        else:
            raise UsageError(f"Unknown argument: {argument}")
    if options.stream_json:
        if options.watch or options.tui or options.verbose or options.live_only or options.json_output:
            raise UsageError("--stream-json cannot be combined with other output modes")
        if "--interval" not in argv and "-n" not in argv:
            options.interval = 5
    options.display_args = tuple(display_args)
    if options.live_only and not options.json_output:
        raise UsageError("--live requires --json")
    if options.tui and (options.watch or options.json_output or options.verbose):
        raise UsageError("--tui cannot be combined with --watch, --json, or --verbose")
    return options


def read_metadata(path: Path) -> dict[str, object]:
    try:
        with path.open("r", encoding="utf-8", errors="replace") as stream:
            first_line = stream.readline(1024 * 1024)
        record = json.loads(first_line)
        payload = record.get("payload")
        if not isinstance(payload, dict):
            return {}
        if record.get("type") == "session_meta" and not payload.get("thread_source"):
            # Codex 0.128 and older wrote no thread_source; only its subagents had an object source.
            payload["thread_source"] = "subagent" if isinstance(payload.get("source"), dict) else "user"
        return payload
    except (OSError, ValueError, json.JSONDecodeError):
        return {}


def open_codex_rollout_paths(
    sessions_dir: Path,
    *,
    ps_output: Optional[str] = None,
    lsof_output: Optional[str] = None,
) -> Optional[set[Path]]:
    """Return rollout files held by live local Codex processes."""
    if ps_output is None:
        try:
            completed = subprocess.run(
                ["ps", "-ax", "-o", "pid=", "-o", "command="],
                capture_output=True,
                text=True,
                timeout=5,
                check=False,
            )
        except (FileNotFoundError, OSError, subprocess.TimeoutExpired):
            return None
        if completed.returncode != 0:
            return None
        ps_output = completed.stdout

    pids: list[str] = []
    for line in ps_output.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) != 2:
            continue
        pid, command = parts
        command_parts = command.split()
        if not command_parts or Path(command_parts[0]).name != "codex":
            continue
        pids.append(pid)
    if not pids:
        return set()

    if lsof_output is None:
        try:
            completed = subprocess.run(
                ["lsof", "-w", "-Fpn", "-p", ",".join(pids)],
                capture_output=True,
                text=True,
                timeout=5,
                check=False,
            )
        except (FileNotFoundError, OSError, subprocess.TimeoutExpired):
            return None
        if completed.returncode != 0:
            return None
        lsof_output = completed.stdout

    try:
        resolved_sessions_dir = sessions_dir.resolve()
    except OSError:
        return None
    paths_by_pid: dict[str, list[Path]] = {pid: [] for pid in pids}
    current_pid = ""
    for line in lsof_output.splitlines():
        if line.startswith("p"):
            current_pid = line[1:]
            continue
        if current_pid not in paths_by_pid or not line.startswith("n"):
            continue
        try:
            path = Path(line[1:]).resolve()
            path.relative_to(resolved_sessions_dir)
        except (OSError, ValueError):
            continue
        if path.name.startswith("rollout-") and path.suffix == ".jsonl":
            paths_by_pid[current_pid].append(path)

    return {path for paths in paths_by_pid.values() for path in paths}


def linux_live_rollouts(sessions_dir: Path) -> Optional[dict[Path, LiveRollout]]:
    """Map rollout files to owning Codex processes without spawning ps/lsof."""
    proc = Path("/proc")
    if sys.platform != "linux" or not proc.is_dir():
        return None
    try:
        resolved_sessions_dir = sessions_dir.resolve()
    except OSError:
        return None
    live: dict[Path, LiveRollout] = {}
    try:
        processes = list(proc.iterdir())
    except OSError:
        return None
    for process in processes:
        if not process.name.isdigit():
            continue
        try:
            if (process / "comm").read_text(encoding="utf-8").strip() != "codex":
                continue
            environment = {
                part.split(b"=", 1)[0].decode("utf-8", "replace"): part.split(b"=", 1)[1].decode("utf-8", "replace")
                for part in (process / "environ").read_bytes().split(b"\0")
                if b"=" in part
            }
            file_descriptors = list((process / "fd").iterdir())
        except (OSError, IndexError):
            continue
        context = LiveRollout(
            pid=int(process.name),
            zellij_session=environment.get("ZELLIJ_SESSION_NAME", ""),
            zellij_pane_id=environment.get("ZELLIJ_PANE_ID", ""),
        )
        for descriptor in file_descriptors:
            try:
                target = Path(os.readlink(descriptor)).resolve()
                target.relative_to(resolved_sessions_dir)
            except (OSError, ValueError):
                continue
            if target.name.startswith("rollout-") and target.suffix == ".jsonl":
                live[target] = context
    return live


@dataclass(frozen=True)
class CodexTui:
    """An interactive Codex process attached to a terminal."""

    context: LiveRollout
    command: str
    cwd: str
    started_at: float


def attribute_daemon_rollouts(
    live: dict[Path, LiveRollout],
    tuis: dict[int, CodexTui],
    metadata_for=read_metadata,
) -> dict[Path, LiveRollout]:
    """Credit rollouts held by the Codex app-server daemon to the TUI showing them.

    Newer Codex keeps rollouts open in a background daemon with no terminal, so the
    holder says nothing about the pane. A TUI matches when `codex resume ID` names the
    session, when it started in the session's directory within seconds of it, or when
    it is the only unmatched TUI left in that directory.
    """
    tui_pids = set(tuis)
    roots: dict[Path, dict[str, object]] = {}
    children: dict[Path, str] = {}
    for path, context in live.items():
        if context.pid in tui_pids:
            continue
        metadata = metadata_for(path)
        root_id = str(metadata.get("session_id") or "")
        # Subagent and review threads share their root session's TUI.
        if metadata.get("thread_source") != "user" and root_id and root_id != metadata.get("id"):
            children[path] = root_id
        else:
            roots[path] = metadata
    claimed: set[int] = set()
    matched: dict[str, LiveRollout] = {}

    def claim(path: Path, pid: int) -> None:
        claimed.add(pid)
        live[path] = tuis[pid].context
        matched[str(roots[path].get("id") or "")] = tuis[pid].context

    for path, metadata in roots.items():
        session_id = str(metadata.get("id") or "")
        named = [pid for pid, tui in tuis.items() if session_id and session_id in tui.command.split()]
        if named:
            claim(path, named[0])
    for path, metadata in roots.items():
        if str(metadata.get("id") or "") in matched:
            continue
        started = parse_start_timestamp(metadata.get("timestamp"), 0)
        near = [
            pid for pid, tui in tuis.items()
            if pid not in claimed and tui.cwd == metadata.get("cwd") and abs(tui.started_at - started) <= 10
        ]
        if len(near) == 1:
            claim(path, near[0])
    unmatched = [path for path, metadata in roots.items() if str(metadata.get("id") or "") not in matched]
    for path in unmatched:
        cwd = roots[path].get("cwd")
        same_cwd_roots = [other for other in unmatched if roots[other].get("cwd") == cwd]
        same_cwd_tuis = [pid for pid, tui in tuis.items() if pid not in claimed and tui.cwd == cwd]
        if len(same_cwd_roots) == 1 and len(same_cwd_tuis) == 1:
            claim(path, same_cwd_tuis[0])
    for path, root_id in children.items():
        if root_id in matched:
            live[path] = matched[root_id]
    return live


def darwin_live_rollouts(sessions_dir: Path) -> Optional[dict[Path, LiveRollout]]:
    """Map live Codex rollouts to tmux/Zellij targets on macOS."""
    if sys.platform != "darwin":
        return None
    try:
        ps = subprocess.run(
            ["ps", "eww", "-ax", "-o", "pid=", "-o", "tty=", "-o", "lstart=", "-o", "command="],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
            env={**os.environ, "LC_ALL": "C"},
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if ps.returncode != 0:
        return None
    process_contexts: dict[str, LiveRollout] = {}
    tui_candidates: dict[str, tuple[str, float]] = {}
    for line in ps.stdout.splitlines():
        parts = line.strip().split(None, 7)
        if len(parts) != 8:
            continue
        pid, tty, command = parts[0], parts[1], parts[7]
        command_head = command.split(None, 1)[0] if command else ""
        if Path(command_head).name != "codex":
            continue
        environment = dict(re.findall(r"(?:^|\s)([A-Z_][A-Z0-9_]*)=(\S+)", command))
        tmux_value = environment.get("TMUX", "")
        process_contexts[pid] = LiveRollout(
            pid=int(pid),
            zellij_session=environment.get("ZELLIJ_SESSION_NAME", ""),
            zellij_pane_id=environment.get("ZELLIJ_PANE_ID", ""),
            tmux_socket=tmux_value.split(",", 1)[0] if tmux_value else "",
            tmux_pane=environment.get("TMUX_PANE", ""),
        )
        if tty not in {"??", "-"} and "app-server" not in command.split():
            try:
                started = time.mktime(time.strptime(" ".join(parts[2:7]), "%a %b %d %H:%M:%S %Y"))
            except ValueError:
                started = 0.0
            tui_candidates[pid] = (command, started)
    if not process_contexts:
        return {}
    try:
        completed = subprocess.run(
            ["lsof", "-w", "-Fpfn", "-p", ",".join(process_contexts)],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if completed.returncode != 0:
        reported = {line[1:] for line in completed.stdout.splitlines() if line.startswith("p")}
        for pid in set(process_contexts) - reported:
            try:
                os.kill(int(pid), 0)
            except ProcessLookupError:
                continue
            except PermissionError:
                return None
            return None
        if not reported:
            return {}
    try:
        resolved_sessions_dir = sessions_dir.resolve()
    except OSError:
        return None
    live: dict[Path, LiveRollout] = {}
    cwds: dict[str, str] = {}
    current_pid = current_fd = ""
    for line in completed.stdout.splitlines():
        if line.startswith("p"):
            current_pid = line[1:]
            continue
        if line.startswith("f"):
            current_fd = line[1:]
            continue
        context = process_contexts.get(current_pid)
        if not context or not line.startswith("n"):
            continue
        if current_fd == "cwd":
            cwds[current_pid] = line[1:]
            continue
        try:
            target = Path(line[1:]).resolve()
            target.relative_to(resolved_sessions_dir)
        except (OSError, ValueError):
            continue
        if target.name.startswith("rollout-") and target.suffix == ".jsonl":
            live[target] = context
    tuis = {
        int(pid): CodexTui(process_contexts[pid], command, cwds.get(pid, ""), started)
        for pid, (command, started) in tui_candidates.items()
    }
    return attribute_daemon_rollouts(live, tuis)


def live_rollouts(sessions_dir: Path, strict: bool = False) -> dict[Path, LiveRollout]:
    """Return live rollout context with exact multiplexer targets when available."""
    linux_result = linux_live_rollouts(sessions_dir)
    if linux_result is not None:
        return linux_result
    darwin_result = darwin_live_rollouts(sessions_dir)
    if darwin_result is not None:
        return darwin_result
    paths = open_codex_rollout_paths(sessions_dir)
    if strict and paths is None:
        raise RuntimeError("Cannot determine live Codex processes")
    return {path: LiveRollout(pid=0) for path in paths or set()}


def discover_transcript_sessions(codex_home: Path, include_subagents: bool = False) -> list[TranscriptSession]:
    """Collect lightweight records for the interactive transcript browser."""
    sessions_dir = codex_home / "sessions"
    archived_dir = codex_home / "archived_sessions"
    thread_index = load_thread_index(codex_home / "state_5.sqlite")
    live_by_path = live_rollouts(sessions_dir)
    sessions: list[TranscriptSession] = []
    for root, archived in ((sessions_dir, False), (archived_dir, True)):
        if not root.is_dir():
            continue
        for path in root.rglob("rollout-*.jsonl"):
            metadata = read_metadata(path)
            thread_source = str(metadata.get("thread_source") or "-")
            if not metadata or (not include_subagents and thread_source != "user"):
                continue
            try:
                rollout_stat = path.stat()
                resolved_path = path.resolve()
            except OSError:
                continue
            session_id = str(metadata.get("id") or metadata.get("session_id") or path.stem)
            database_row = thread_index.get(session_id, {})
            title = session_title(database_row) or session_id
            git = metadata.get("git") if isinstance(metadata.get("git"), dict) else {}
            sessions.append(
                TranscriptSession(
                    session_id=session_id,
                    path=path,
                    cwd=str(metadata.get("cwd") or database_row.get("cwd") or "-"),
                    title=" ".join(title.split()),
                    updated_at=rollout_stat.st_mtime,
                    live=live_by_path.get(resolved_path),
                    archived=archived,
                    thread_source=thread_source,
                    model=str(database_row.get("model") or metadata.get("model") or ""),
                    reasoning_effort=str(database_row.get("reasoning_effort") or ""),
                    git_branch=str(git.get("branch") or database_row.get("git_branch") or ""),
                    started_at=parse_start_timestamp(metadata.get("timestamp"), rollout_stat.st_mtime),
                )
            )
    sessions.sort(key=lambda session: (not bool(session.live), -session.updated_at, session.session_id))
    return sessions


def transcript_message(record: object, fallback_time: float) -> Optional[TranscriptMessage]:
    """Extract one user-visible message from a JSONL record."""
    if not isinstance(record, dict) or record.get("type") != "event_msg":
        return None
    payload = record.get("payload")
    if not isinstance(payload, dict):
        return None
    event_type = payload.get("type")
    role = "user" if event_type == "user_message" else "assistant" if event_type == "agent_message" else ""
    message = payload.get("message")
    if not role or not isinstance(message, str) or not message.strip():
        return None
    return TranscriptMessage(
        role=role,
        text=message.strip(),
        timestamp=parse_start_timestamp(record.get("timestamp"), fallback_time),
        phase=str(payload.get("phase") or ""),
    )


def read_transcript(path: Path, offset: int = 0) -> tuple[list[TranscriptMessage], int]:
    """Read complete user/assistant events at or after offset, tolerating an active partial line."""
    try:
        rollout_stat = path.stat()
        size = rollout_stat.st_size
        if offset < 0 or offset > size:
            offset = 0
        with path.open("rb") as stream:
            stream.seek(offset)
            data = stream.read()
    except OSError:
        return [], offset
    if not data:
        return [], offset
    complete_size = len(data) if data.endswith(b"\n") else data.rfind(b"\n") + 1
    messages: list[TranscriptMessage] = []
    fallback_time = rollout_stat.st_mtime
    for raw_line in data[:complete_size].splitlines():
        if b'"event_msg"' not in raw_line or (
            b'"user_message"' not in raw_line and b'"agent_message"' not in raw_line
        ):
            continue
        try:
            record = json.loads(raw_line)
        except (UnicodeDecodeError, json.JSONDecodeError):
            continue
        message = transcript_message(record, fallback_time)
        if message:
            messages.append(message)
    return messages, offset + complete_size


def load_database_threads(path: Path) -> dict[str, dict[str, object]]:
    if not path.is_file():
        return {}
    requested_columns = (
        "cwd",
        "git_sha",
        "git_branch",
        "git_origin_url",
        "model",
        "reasoning_effort",
        "name",
        "title",
        "first_user_message",
        "tokens_used",
        "agent_nickname",
        "agent_path",
        "updated_at",
        "recency_at",
    )
    try:
        with closing(sqlite3.connect(f"file:{path}?mode=ro", uri=True)) as connection:
            connection.row_factory = sqlite3.Row
            available_columns = {str(row[1]) for row in connection.execute("pragma table_info(threads)")}
            if "id" not in available_columns:
                return {}
            selected_columns = ["id"] + [
                column if column in available_columns else f"NULL AS {column}"
                for column in requested_columns
            ]
            rows = connection.execute(f"select {', '.join(selected_columns)} from threads").fetchall()
    except sqlite3.Error:
        return {}
    return {row["id"]: dict(row) for row in rows}


def load_thread_index(path: Path) -> dict[str, dict[str, object]]:
    """Read metadata plus saved names, including installations without SQLite names."""
    index = load_database_threads(path)
    names: dict[str, str] = {}
    try:
        with path.with_name("session_index.jsonl").open("rb") as stream:
            for line in stream:
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue  # A concurrent append can leave an incomplete last line.
                if not isinstance(entry, dict):
                    continue
                session_id, name = entry.get("id"), entry.get("thread_name")
                if isinstance(session_id, str) and session_id and isinstance(name, str) and name.strip():
                    names[session_id] = name
    except OSError:
        pass
    for session_id, name in names.items():
        row = index.setdefault(session_id, {})
        if not str(row.get("name") or "").strip():
            row["name"] = name
    return index


def session_title(row: dict[str, object]) -> str:
    """Prefer a saved name; never use the unmodified first request as a title."""
    name = " ".join(str(row.get("name") or "").split())
    if name:
        return name
    title = " ".join(str(row.get("title") or "").split())
    first_request = " ".join(str(row.get("first_user_message") or "").split())
    return title if title != first_request else ""


def local_time(timestamp: float) -> str:
    return datetime.fromtimestamp(timestamp).astimezone().strftime("%Y-%m-%d %H:%M")


def compact_local_time(timestamp: float) -> str:
    local = datetime.fromtimestamp(timestamp).astimezone()
    return f"{local.month}/{local.day} {local:%H:%M}"


def parse_start_timestamp(value: object, fallback: float) -> float:
    if not isinstance(value, str):
        return fallback
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return fallback


def duration_text(seconds: float) -> str:
    if seconds < 0:
        return "-"
    seconds = int(seconds)
    if seconds < 60:
        return f"{seconds}s"
    minutes, _ = divmod(seconds, 60)
    days, minutes = divmod(minutes, 24 * 60)
    hours, minutes = divmod(minutes, 60)
    parts = [f"{value}{suffix}" for value, suffix in ((days, "d"), (hours, "h"), (minutes, "m")) if value]
    return " ".join(parts[:2]) or "0m"


def number_text(value: object) -> str:
    if value is None:
        return "-"
    try:
        number = int(value)
    except (TypeError, ValueError):
        return "-"
    if number >= 1_000_000_000:
        return f"{number / 1_000_000_000:.2f}B"
    if number >= 1_000_000:
        return f"{number / 1_000_000:.2f}M"
    if number >= 1_000:
        return f"{number / 1_000:.1f}k"
    return str(number)


def header_details(cwd: str, parts: list[str], width: int) -> str:
    """Join the session header's detail line, shortening only the path so the other parts stay whole."""
    rest = " · ".join(part for part in parts if part)
    if cwd:
        room = max(12, width - (len(rest) + 3 if rest else 0))
        # Keep the end of the path, the part that names the project: …/dev/supernova.
        if len(cwd) > room:
            cwd = "…" + cwd[-(room - 1):]
    return compact_text(" · ".join(part for part in (cwd, rest) if part), width)


def compact_text(value: object, width: int) -> str:
    text = " ".join(str(value or "-").replace("\n", " ").split())
    if len(text) <= width:
        return text
    if width <= 3:
        return text[:width]
    return text[: width - 3] + "..."


def user_text(content: object) -> str:
    if not isinstance(content, list):
        return ""
    texts = [
        item.get("text", "")
        for item in content
        if isinstance(item, dict) and item.get("type") == "input_text"
    ]
    if not texts:
        return ""
    text = str(texts[-1]).strip()
    for marker in ("</environment_context>", "</INSTRUCTIONS>"):
        if marker in text:
            text = text.rsplit(marker, 1)[-1].strip()
    return " ".join(text.split())


def current_state(
    active_task_starts: dict[str, float],
    last_terminal_state: Optional[tuple[str, float]],
    session_started_at: float,
) -> tuple[str, float]:
    if active_task_starts:
        return "open", min(active_task_starts.values())
    if last_terminal_state:
        return last_terminal_state
    return "unknown", session_started_at


def client_type(source: str) -> str:
    return {
        "cli": "CLI",
        "codex-tui": "CLI",
        "codex_cli_rs": "CLI",
        "Codex Desktop": "APP",
        "codex_work_desktop": "APP",
        "subagent": "AGENT",
        "vscode": "APP",
    }.get(source, "OTHER")


def session_status(liveness: str, state: str) -> str:
    if liveness == "CLOSED":
        return "CLOSED"
    if liveness == "OPEN":
        if state == "open":
            return "BUSY"
        if state in {"complete", "aborted"}:
            return "WAITING"
    return "UNKNOWN"


class RolloutSummary:
    def __init__(self, modified):
        self.modified = modified
        self.model = ""
        self.effort = ""
        self.records = self.user_turns = self.assistant_messages = self.reasoning_items = self.tool_calls = 0
        self.task_starts = self.task_completes = self.aborted_turns = 0
        self.active_task_starts: dict[str, float] = {}
        self.last_terminal_state: Optional[tuple[str, float]] = None
        self.requests: list[str] = []
        self.latest_tokens: Optional[dict[str, object]] = None
        self.context_used: Optional[int] = None
        self.context_window: Optional[int] = None
        self.last_record: dict[str, object] = {}

    def consume(self, record, position):
        self.records += 1
        payload = record.get("payload")
        self.last_record = {"type": record.get("type"), "payload": {"type": payload.get("type", "") if isinstance(payload, dict) else ""}}
        if not isinstance(payload, dict):
            return
        if record.get("type") == "event_msg":
            event_type = payload.get("type")
            event_time = parse_start_timestamp(record.get("timestamp"), self.modified)
            turn_id = str(payload.get("turn_id") or f"event-{self.records}")
            if event_type == "task_started":
                self.task_starts += 1
                self.active_task_starts[turn_id] = event_time
            elif event_type == "task_complete":
                self.task_completes += 1
                self.active_task_starts.pop(turn_id, None)
                self.last_terminal_state = ("complete", event_time)
            elif event_type == "turn_aborted":
                self.aborted_turns += 1
                self.active_task_starts.pop(turn_id, None)
                self.last_terminal_state = ("aborted", event_time)
            elif event_type == "token_count":
                info = payload.get("info") if isinstance(payload.get("info"), dict) else {}
                token_info = info.get("total_token_usage")
                if isinstance(token_info, dict):
                    self.latest_tokens = token_info
                # The last request's tokens are what the context currently holds.
                last_usage = info.get("last_token_usage")
                if isinstance(last_usage, dict) and isinstance(last_usage.get("total_tokens"), int):
                    self.context_used = last_usage["total_tokens"]
                if isinstance(info.get("model_context_window"), int):
                    self.context_window = info["model_context_window"]
            return
        if record.get("type") == "turn_context":
            self.model = payload.get("model") or self.model
            self.effort = payload.get("effort") or payload.get("reasoning_effort") or self.effort
        if record.get("type") != "response_item":
            return
        response_type = payload.get("type")
        if response_type == "message":
            if payload.get("role") == "user":
                self.user_turns += 1
                request = user_text(payload.get("content"))
                if request:
                    self.requests[:] = [self.requests[0], request] if self.requests else [request]
            elif payload.get("role") == "assistant":
                self.assistant_messages += 1
        elif response_type == "reasoning":
            self.reasoning_items += 1
        elif response_type in {"custom_tool_call", "function_call"}:
            self.tool_calls += 1


def scan_rollout(
    info: dict[str, object],
    thread_index: dict[str, dict[str, object]],
    agent_counts: Counter[str],
    cache: Optional[JsonlCache] = None,
) -> dict[str, object]:
    metadata = info["metadata"]
    rollout_path = info["path"]
    rollout_stat = info["stat"]
    if not isinstance(metadata, dict) or not isinstance(rollout_path, Path):
        raise RuntimeError("invalid rollout metadata")
    reader = cache or JsonlCache()
    try:
        summary = reader.read(rollout_path, lambda: RolloutSummary(rollout_stat.st_mtime), RolloutSummary.consume)
    except OSError as error:
        raise RuntimeError(f"could not read {rollout_path}: {error}") from error
    records = summary.records
    user_turns = summary.user_turns
    assistant_messages = summary.assistant_messages
    reasoning_items = summary.reasoning_items
    tool_calls = summary.tool_calls
    task_starts = summary.task_starts
    task_completes = summary.task_completes
    aborted_turns = summary.aborted_turns
    active_task_starts = summary.active_task_starts
    last_terminal_state = summary.last_terminal_state
    requests = summary.requests
    latest_tokens = summary.latest_tokens
    context_used = summary.context_used
    context_window = summary.context_window
    last_record = summary.last_record
    rollout_id = str(metadata.get("id") or metadata.get("session_id") or rollout_path.stem)
    database_row = thread_index.get(rollout_id, {})
    start_time = parse_start_timestamp(metadata.get("timestamp"), rollout_stat.st_mtime)
    git = metadata.get("git") if isinstance(metadata.get("git"), dict) else {}
    branch = git.get("branch") or database_row.get("git_branch") or ""
    commit = git.get("commit_hash") or database_row.get("git_sha") or ""
    remote = git.get("repository_url") or database_row.get("git_origin_url") or ""
    git_summary = "-"
    if branch:
        git_summary = str(branch)
        if commit:
            git_summary += f"@{str(commit)[:12]}"
    first_request = requests[0] if requests else database_row.get("first_user_message") or database_row.get("title") or ""
    last_request = requests[-1] if requests else first_request
    thread_source = str(metadata.get("thread_source") or "-")
    source = "subagent" if isinstance(metadata.get("originator") or metadata.get("source"), dict) else str(metadata.get("originator") or metadata.get("source") or "-")
    total_tokens = latest_tokens.get("total_tokens") if latest_tokens else database_row.get("tokens_used")
    token_metrics = latest_tokens if thread_source != "subagent" else None
    if thread_source == "subagent":
        total_tokens = None
    state, state_started_at = current_state(active_task_starts, last_terminal_state, start_time)
    state_elapsed_seconds = max(0, time.time() - state_started_at)
    return {
        "rank": 0,
        "session_id": rollout_id,
        "title": session_title(database_row) or "-",
        "root_session_id": metadata.get("session_id") or rollout_id,
        "parent_thread_id": metadata.get("parent_thread_id"),
        "thread_source": thread_source,
        "last_activity": rollout_stat.st_mtime,
        "last_activity_local": local_time(rollout_stat.st_mtime),
        "last_activity_compact": compact_local_time(rollout_stat.st_mtime),
        "started_at": start_time,
        "started_at_local": local_time(start_time),
        "started_at_compact": compact_local_time(start_time),
        "wall_duration_seconds": max(0, rollout_stat.st_mtime - start_time),
        "wall_duration": duration_text(rollout_stat.st_mtime - start_time),
        "state": state,
        "state_started_at": state_started_at,
        "state_started_at_local": local_time(state_started_at),
        "state_elapsed_seconds": state_elapsed_seconds,
        "state_elapsed": duration_text(state_elapsed_seconds),
        "last_record": f"{last_record.get('type', 'unknown')}/{last_record.get('payload', {}).get('type', '')}".rstrip("/"),
        "cwd": metadata.get("cwd") or database_row.get("cwd") or "-",
        "git_branch": branch or None,
        "git_commit": commit or None,
        "git_remote": remote or None,
        "git_summary": git_summary,
        "source": source,
        "client_type": "AGENT" if thread_source == "subagent" else client_type(source),
        "cli_version": metadata.get("cli_version") or "-",
        "model": database_row.get("model") or summary.model or metadata.get("model") or "-",
        "reasoning_effort": database_row.get("reasoning_effort") or summary.effort or "-",
        "file_mib": round(rollout_stat.st_size / (1024 * 1024), 1),
        "records": records,
        "user_turns": user_turns,
        "assistant_messages": assistant_messages,
        "reasoning_items": reasoning_items,
        "tool_calls": tool_calls,
        "task_starts": task_starts,
        "task_completes": task_completes,
        "aborted_turns": aborted_turns,
        "first_user_request": first_request or "-",
        "last_user_request": last_request or "-",
        "tokens_total": total_tokens,
        "context_used_tokens": context_used,
        "context_window_tokens": context_window,
        "tokens_cached": token_metrics.get("cached_input_tokens") if token_metrics else None,
        "tokens_output": token_metrics.get("output_tokens") if token_metrics else None,
        "tokens_reasoning": token_metrics.get("reasoning_output_tokens") if token_metrics else None,
        "subagent_rollouts": agent_counts[str(metadata.get("session_id") or rollout_id)],
    }


def cached_scan_rollout(
    info: dict[str, object],
    thread_index: dict[str, dict[str, object]],
    agent_counts: Counter[str],
    cache: Optional[ReportCache],
) -> dict[str, object]:
    """Return a fresh row, reusing an unchanged rollout scan in watch mode."""
    rollout_path = info.get("path")
    rollout_stat = info.get("stat")
    if not isinstance(rollout_path, Path) or not isinstance(rollout_stat, os.stat_result):
        raise RuntimeError("invalid rollout metadata")
    cached = cache.rows.get(rollout_path) if cache else None
    if cached and cached[:2] == ((rollout_stat.st_dev, rollout_stat.st_ino, rollout_stat.st_mtime_ns), rollout_stat.st_size):
        row = dict(cached[2])
    else:
        row = scan_rollout(info, thread_index, agent_counts, cache.transcripts if cache else None)
        if cache:
            cache.rows[rollout_path] = ((rollout_stat.st_dev, rollout_stat.st_ino, rollout_stat.st_mtime_ns), rollout_stat.st_size, dict(row))
    # Names can change without the transcript changing (for example after auto-titling).
    row["title"] = session_title(thread_index.get(str(row["session_id"]), {})) or "-"
    metadata = info.get("metadata")
    if isinstance(metadata, dict):
        row["subagent_rollouts"] = agent_counts[str(metadata.get("session_id") or row["session_id"])]
    state_started_at = row.get("state_started_at")
    if isinstance(state_started_at, (int, float)):
        elapsed = max(0, time.time() - state_started_at)
        row["state_elapsed_seconds"] = elapsed
        row["state_elapsed"] = duration_text(elapsed)
    return row


def agent_task_label(metadata: dict[str, object], database_row: dict[str, object]) -> str:
    nickname = str(metadata.get("agent_nickname") or database_row.get("agent_nickname") or "").strip()
    path = str(metadata.get("agent_path") or database_row.get("agent_path") or "").strip()
    if " the " in nickname:
        nickname = nickname.split(" the ", 1)[0]
    task = path.rstrip("/").rsplit("/", 1)[-1] if path else ""
    return " · ".join(part for part in (nickname, task) if part) or "-"


def latest_task_lifecycle(path: Path, fallback: float) -> Optional[tuple[str, float]]:
    """Read the newest task lifecycle event without rescanning the whole rollout."""
    event_states = {
        "task_started": "active",
        "task_complete": "idle",
        "turn_aborted": "interrupted",
    }
    chunk_size = 256 * 1024
    suffix = b""
    try:
        with path.open("rb") as stream:
            position = stream.seek(0, os.SEEK_END)
            while position:
                start = max(0, position - chunk_size)
                stream.seek(start)
                parts = (stream.read(position - start) + suffix).split(b"\n")
                if start:
                    suffix = parts[0]
                    candidates = parts[1:]
                else:
                    candidates = parts
                for raw_line in reversed(candidates):
                    if (
                        b'"type":"event_msg"' not in raw_line
                        or (b'"type":"task_' not in raw_line and b'"type":"turn_aborted"' not in raw_line)
                    ):
                        continue
                    try:
                        record = json.loads(raw_line)
                    except (TypeError, UnicodeDecodeError, json.JSONDecodeError):
                        continue
                    payload = record.get("payload")
                    if not isinstance(payload, dict):
                        continue
                    state = event_states.get(str(payload.get("type")))
                    if state:
                        return state, parse_start_timestamp(record.get("timestamp"), fallback)
                position = start
    except OSError:
        return None
    return None


def open_subagent_row(
    info: dict[str, object],
    thread_index: dict[str, dict[str, object]],
    display_id: str,
) -> Optional[dict[str, object]]:
    metadata = info.get("metadata")
    rollout_path = info.get("path")
    rollout_stat = info.get("stat")
    if not isinstance(metadata, dict) or not isinstance(rollout_path, Path) or not isinstance(rollout_stat, os.stat_result):
        return None
    session_id = str(metadata.get("id") or rollout_path.stem)
    database_row = thread_index.get(session_id, {})
    start_time = parse_start_timestamp(metadata.get("timestamp"), rollout_stat.st_mtime)
    lifecycle = info.get("agent_lifecycle")
    if not isinstance(lifecycle, tuple) or len(lifecycle) != 2:
        return None
    state, state_started_at = lifecycle
    if state != "active" or not isinstance(state_started_at, float):
        return None
    git = metadata.get("git") if isinstance(metadata.get("git"), dict) else {}
    branch = git.get("branch") or database_row.get("git_branch") or ""
    commit = git.get("commit_hash") or database_row.get("git_sha") or ""
    git_summary = str(branch) if branch else "-"
    if commit:
        git_summary += f"@{str(commit)[:12]}"
    task_label = agent_task_label(metadata, database_row)
    return {
        "display_id": display_id,
        "row_kind": "subagent",
        "rank": 0,
        "session_id": session_id,
        "root_session_id": metadata.get("session_id") or "-",
        "parent_thread_id": metadata.get("parent_thread_id"),
        "thread_source": "subagent",
        "last_activity": rollout_stat.st_mtime,
        "last_activity_local": local_time(rollout_stat.st_mtime),
        "last_activity_compact": compact_local_time(rollout_stat.st_mtime),
        "started_at": start_time,
        "started_at_local": local_time(start_time),
        "started_at_compact": compact_local_time(start_time),
        "wall_duration_seconds": None,
        "wall_duration": "-",
        "state": state,
        "state_started_at": state_started_at,
        "state_started_at_local": local_time(state_started_at),
        "state_elapsed_seconds": max(0, time.time() - state_started_at),
        "state_elapsed": duration_text(max(0, time.time() - state_started_at)),
        "liveness": "OPEN",
        "status": "ACTIVE",
        "last_record": "-",
        "cwd": metadata.get("cwd") or database_row.get("cwd") or "-",
        "git_branch": branch or None,
        "git_commit": commit or None,
        "git_remote": git.get("repository_url") or database_row.get("git_origin_url") or None,
        "git_summary": git_summary,
        "source": "subagent",
        "client_type": "AGENT",
        "cli_version": metadata.get("cli_version") or "-",
        "model": database_row.get("model") or metadata.get("model") or "-",
        "reasoning_effort": database_row.get("reasoning_effort") or "-",
        "file_mib": round(rollout_stat.st_size / (1024 * 1024), 1),
        "records": None,
        "user_turns": None,
        "assistant_messages": None,
        "reasoning_items": None,
        "tool_calls": None,
        "task_starts": None,
        "task_completes": None,
        "aborted_turns": None,
        "first_user_request": "-",
        "last_user_request": "-",
        "table_detail": task_label,
        "tokens_total": None,
        "tokens_cached": None,
        "tokens_output": None,
        "tokens_reasoning": None,
        "subagent_rollouts": None,
    }


def active_subagents_by_root(
    files: list[dict[str, object]],
    open_rollouts: Optional[set[Path]],
) -> dict[str, list[dict[str, object]]]:
    if open_rollouts is None:
        return {}
    paths: dict[Path, dict[str, object]] = {}
    for info in files:
        path = info.get("path")
        if not isinstance(path, Path):
            continue
        try:
            paths[path.resolve()] = info
        except OSError:
            continue
    by_root: dict[str, list[dict[str, object]]] = {}
    for path in open_rollouts:
        info = paths.get(path)
        metadata = info.get("metadata") if info else None
        if not isinstance(metadata, dict) or metadata.get("thread_source") != "subagent":
            continue
        rollout_stat = info.get("stat")
        if not isinstance(rollout_stat, os.stat_result):
            continue
        lifecycle = latest_task_lifecycle(path, rollout_stat.st_mtime)
        if not lifecycle or lifecycle[0] != "active":
            continue
        root_session_id = metadata.get("session_id")
        if root_session_id:
            info = {**info, "agent_lifecycle": lifecycle}
            by_root.setdefault(str(root_session_id), []).append(info)
    return by_root


def ordered_active_subagents(
    root_session_id: str,
    infos: list[dict[str, object]],
) -> list[tuple[dict[str, object], str]]:
    def metadata_for(info: dict[str, object]) -> dict[str, object]:
        metadata = info.get("metadata")
        return metadata if isinstance(metadata, dict) else {}

    def session_id_for(info: dict[str, object]) -> str:
        metadata = metadata_for(info)
        path = info.get("path")
        return str(metadata.get("id") or (path.stem if isinstance(path, Path) else ""))

    def tree_session_id(session_id: str) -> str:
        return f"{session_id[:4]}…{session_id[-4:]}" if len(session_id) > 8 else session_id

    def sort_key(info: dict[str, object]) -> tuple[float, str]:
        rollout_stat = info.get("stat")
        fallback = rollout_stat.st_mtime if isinstance(rollout_stat, os.stat_result) else 0.0
        return parse_start_timestamp(metadata_for(info).get("timestamp"), fallback), session_id_for(info)

    by_id = {session_id_for(info): info for info in infos}
    children: dict[str, list[dict[str, object]]] = {}
    roots: list[dict[str, object]] = []
    for info in infos:
        parent = str(metadata_for(info).get("parent_thread_id") or root_session_id)
        if parent == root_session_id or parent not in by_id:
            roots.append(info)
        else:
            children.setdefault(parent, []).append(info)
    roots.sort(key=sort_key)
    for entries in children.values():
        entries.sort(key=sort_key)

    ordered: list[tuple[dict[str, object], str]] = []
    seen: set[str] = set()

    def visit(entries: list[dict[str, object]], prefix: str) -> None:
        for index, info in enumerate(entries):
            last = index == len(entries) - 1
            session_id = session_id_for(info)
            if session_id in seen:
                continue
            seen.add(session_id)
            ordered.append((info, f"{prefix}{'└─' if last else '├─'}{tree_session_id(session_id)}"))
            visit(children.get(session_id, []), prefix + ("  " if last else "│ "))

    visit(roots, "")
    return ordered


def table_rows_with_active_subagents(
    root_rows: list[dict[str, object]],
    files: list[dict[str, object]],
    open_rollouts: Optional[set[Path]],
    thread_index: dict[str, dict[str, object]],
) -> list[dict[str, object]]:
    subagents = active_subagents_by_root(files, open_rollouts)
    table_rows: list[dict[str, object]] = []
    for row in root_rows:
        row["row_kind"] = "root"
        row["display_id"] = str(row["session_id"])[:8]
        table_rows.append(row)
        for info, display_id in ordered_active_subagents(str(row["session_id"]), subagents.get(str(row["session_id"]), [])):
            agent_row = open_subagent_row(info, thread_index, display_id)
            if agent_row:
                table_rows.append(agent_row)
    return table_rows


def metric_pair(row: dict[str, object], first_key: str, second_key: str) -> str:
    first, second = row.get(first_key), row.get(second_key)
    return f"{first}/{second}" if first is not None and second is not None else "-"


def metric_triplet(row: dict[str, object], keys: tuple[str, str, str]) -> str:
    values = [row.get(key) for key in keys]
    return "/".join(str(value) for value in values) if all(value is not None for value in values) else "-"


def relative_cwd(cwd: object) -> str:
    text = str(cwd)
    home = str(Path.home())
    return "~" + text[len(home):] if text.startswith(home + os.sep) else text


def resume_url(row: dict[str, object], tmux_socket: str, tmux_pane: str) -> Optional[str]:
    if row["thread_source"] != "user":
        return None
    try:
        session_id = str(uuid.UUID(str(row["session_id"])))
    except (AttributeError, TypeError, ValueError):
        return None
    cwd = row["cwd"]
    if not isinstance(cwd, str) or not os.path.isabs(cwd) or not os.path.isdir(cwd):
        return None
    query: dict[str, str] = {"session": session_id, "cwd": cwd}
    if tmux_socket and tmux_pane:
        query["tmux_socket"] = tmux_socket
        query["tmux_pane"] = tmux_pane
    return "codex-resume://resume?" + urllib.parse.urlencode(query, quote_via=urllib.parse.quote)


def terminal_hyperlink(url: str, text: str) -> str:
    return f"\033]8;;{url}\033\\{text}\033]8;;\033\\"


def highlight_scores(rows: list[dict[str, object]]) -> dict[str, int]:
    root_rows = [row for row in rows if row.get("row_kind", "root") == "root"]
    scores = {
        "U/A": [int(row["user_turns"]) + int(row["assistant_messages"]) for row in root_rows],
        "C/S/A": [int(row["task_completes"]) + int(row["task_starts"]) + int(row["aborted_turns"]) for row in root_rows],
        "TOKENS": [int(row["tokens_total"] or 0) for row in root_rows],
    }
    return {column: max(values) for column, values in scores.items()}


def row_score(row: dict[str, object], column: str) -> int:
    if column == "U/A":
        return int(row["user_turns"]) + int(row["assistant_messages"])
    if column == "C/S/A":
        return int(row["task_completes"]) + int(row["task_starts"]) + int(row["aborted_turns"])
    if column == "TOKENS":
        return int(row["tokens_total"] or 0)
    raise ValueError(f"unsupported score column: {column}")


def highlight(text: str) -> str:
    return f"\033[1;33m{text}\033[0m"


def render_table(rows: list[dict[str, object]], links_enabled: bool, color_enabled: bool, stream: TextIO) -> None:
    terminal_width = int(os.environ.get("COLUMNS") or shutil.get_terminal_size((160, 24)).columns)
    if terminal_width >= 180:
        columns = [
            ("ID", 14, lambda row: row.get("display_id", str(row["session_id"])[:8])), ("TYPE", 5, lambda row: row["client_type"]),
            ("CREATED", 11, lambda row: row["started_at_compact"]), ("STATUS", 8, lambda row: row["status"]),
            ("ELAPSED", 11, lambda row: row["state_elapsed"]),
            ("CWD", 24, lambda row: relative_cwd(row["cwd"])), ("GIT", 22, lambda row: row["git_summary"]),
            ("MODEL", 15, lambda row: row["model"]), ("U/A", 9, lambda row: metric_pair(row, "user_turns", "assistant_messages")),
            ("C/S/A", 11, lambda row: metric_triplet(row, ("task_completes", "task_starts", "aborted_turns"))),
            ("TOKENS", 10, lambda row: number_text(row["tokens_total"])),
            ("TASK / LAST REQUEST", max(19, terminal_width - 151), lambda row: row.get("table_detail", row["last_user_request"])),
        ]
    elif terminal_width >= 160:
        columns = [
            ("ID", 14, lambda row: row.get("display_id", str(row["session_id"])[:8])), ("TYPE", 5, lambda row: row["client_type"]),
            ("CREATED", 11, lambda row: row["started_at_compact"]), ("STATUS", 8, lambda row: row["status"]),
            ("ELAPSED", 11, lambda row: row["state_elapsed"]),
            ("CWD", 19, lambda row: relative_cwd(row["cwd"])), ("GIT", 20, lambda row: row["git_summary"]),
            ("MODEL", 15, lambda row: row["model"]),
            ("C/S/A", 11, lambda row: metric_triplet(row, ("task_completes", "task_starts", "aborted_turns"))),
            ("TOKENS", 10, lambda row: number_text(row["tokens_total"])),
            ("TASK / LAST REQUEST", max(19, terminal_width - 134), lambda row: row.get("table_detail", row["last_user_request"])),
        ]
    elif terminal_width >= 140:
        columns = [
            ("ID", 14, lambda row: row.get("display_id", str(row["session_id"])[:8])), ("CREATED", 11, lambda row: row["started_at_compact"]),
            ("STATUS", 8, lambda row: row["status"]), ("ELAPSED", 11, lambda row: row["state_elapsed"]),
            ("CWD", 26, lambda row: relative_cwd(row["cwd"])),
            ("GIT", 20, lambda row: row["git_summary"]),
            ("C/S/A", 11, lambda row: metric_triplet(row, ("task_completes", "task_starts", "aborted_turns"))),
            ("TOKENS", 10, lambda row: number_text(row["tokens_total"])),
            ("TASK / LAST REQUEST", max(19, terminal_width - 119), lambda row: row.get("table_detail", row["last_user_request"])),
        ]
    else:
        columns = [
            ("ID", 14, lambda row: row.get("display_id", str(row["session_id"])[:8])), ("CREATED", 11, lambda row: row["started_at_compact"]),
            ("STATUS", 8, lambda row: row["status"]),
            ("CWD", 20, lambda row: relative_cwd(row["cwd"])),
            ("TASK / LAST REQUEST", max(20, terminal_width - 57), lambda row: row.get("table_detail", row["last_user_request"])),
        ]
    rendered_rows = [[compact_text(getter(row), width) for _, width, getter in columns] for row in rows]
    widths = [max(len(header), *(len(row[index]) for row in rendered_rows)) for index, (header, _, _) in enumerate(columns)]
    print(" ".join(f"{name:<{width}}" for (name, _, _), width in zip(columns, widths)).rstrip(), file=stream)
    print(" ".join("-" * width for width in widths).rstrip(), file=stream)
    id_index = next((index for index, (name, _, _) in enumerate(columns) if name == "ID"), None)
    highest_scores = highlight_scores(rows)
    tmux_environment = os.environ.get("TMUX", "")
    tmux_socket = tmux_environment.split(",", 1)[0] if tmux_environment else ""
    tmux_pane = os.environ.get("TMUX_PANE", "")
    for raw_row, rendered_row in zip(rows, rendered_rows):
        id_url: Optional[str] = None
        if links_enabled and id_index is not None:
            id_url = resume_url(raw_row, tmux_socket, tmux_pane)
        cells = []
        for index, (value, width) in enumerate(zip(rendered_row, widths)):
            cell = f"{value:<{width}}"
            if index == len(rendered_row) - 1:
                cell = cell.rstrip()
            column = columns[index][0]
            if raw_row.get("row_kind", "root") == "root" and color_enabled and column in highest_scores and row_score(raw_row, column) == highest_scores[column]:
                cell = highlight(cell)
            if index == id_index and id_url:
                cell = terminal_hyperlink(id_url, cell)
            cells.append(cell)
        print(" ".join(cells), file=stream)


def render_details(rows: list[dict[str, object]], stream: TextIO) -> None:
    for row in rows:
        print(file=stream)
        print(f"#{row['rank']}  {row['session_id']}  {row['status']}", file=stream)
        print(f"  Started: {row['started_at_local']}  Last seen: {row['last_activity_local']}  Wall span: {row['wall_duration']}", file=stream)
        print(f"  Lifecycle: {str(row['state']).upper()} since {row['state_started_at_local']} ({row['state_elapsed']})", file=stream)
        print(f"  Source: {row['source']} {row['cli_version']}  Model: {row['model']}  Reasoning: {row['reasoning_effort']}", file=stream)
        print(f"  CWD: {row['cwd']}", file=stream)
        if row["git_branch"]:
            print(f"  Git: {row['git_branch']} @ {row['git_commit'] or '-'}  {row['git_remote'] or ''}".rstrip(), file=stream)
        print(f"  Log: {row['file_mib']:.1f} MiB, {row['records']:,} records, last record {row['last_record']}", file=stream)
        print(f"  Messages: {row['user_turns']} user / {row['assistant_messages']} assistant; {row['reasoning_items']} reasoning; {row['tool_calls']:,} tool calls", file=stream)
        print(f"  Tasks: {row['task_completes']}/{row['task_starts']} complete/started; {row['aborted_turns']} aborted; {row['subagent_rollouts']} subagent rollouts", file=stream)
        token_parts = [f"total {number_text(row['tokens_total'])}"]
        for label, key in (("cached", "tokens_cached"), ("output", "tokens_output"), ("reasoning", "tokens_reasoning")):
            if row[key] is not None:
                token_parts.append(f"{label} {number_text(row[key])}")
        print("  Tokens: " + ", ".join(token_parts), file=stream)
        print(f"  First request: {row['first_user_request']}", file=stream)
        print(f"  Last request: {row['last_user_request']}", file=stream)


def links_are_enabled(options: ReportOptions, output_is_tty: bool, force_links: bool) -> bool:
    return not options.json_output and not options.no_links and os.environ.get("CODEX_SESSIONS_LINKS") != "0" and (output_is_tty or force_links or os.environ.get("CODEX_SESSIONS_LINKS") == "1")


def report(
    options: ReportOptions,
    stream: TextIO,
    error_stream: TextIO,
    output_is_tty: bool,
    force_links: bool = False,
    cache: Optional[ReportCache] = None,
) -> int:
    codex_home = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))
    sessions_dir = codex_home / "sessions"
    db_path = codex_home / "state_5.sqlite"
    if not sessions_dir.is_dir():
        print(f"Error: Codex sessions directory not found at {sessions_dir}", file=error_stream)
        return 1
    files: list[dict[str, object]] = []
    for path in sessions_dir.rglob("rollout-*.jsonl"):
        try:
            rollout_stat = path.stat()
        except OSError:
            continue
        metadata = read_metadata(path)
        if metadata:
            files.append({"path": path, "stat": rollout_stat, "metadata": metadata})
    if not files:
        print(f"No Codex session rollouts found in {sessions_dir}", file=error_stream)
        return 1
    agent_counts: Counter[str] = Counter(
        str(info["metadata"].get("session_id"))
        for info in files
        if isinstance(info["metadata"], dict) and info["metadata"].get("thread_source") == "subagent" and info["metadata"].get("session_id")
    )
    thread_index = load_thread_index(db_path)
    live_contexts = live_rollouts(sessions_dir)
    open_rollouts = set(live_contexts)
    candidates = files if options.include_subagents else [info for info in files if isinstance(info["metadata"], dict) and info["metadata"].get("thread_source") == "user"]
    if options.live_only:
        live_paths = set(live_contexts)
        filtered: list[dict[str, object]] = []
        for info in candidates:
            try:
                if Path(info["path"]).resolve() in live_paths:
                    filtered.append(info)
            except OSError:
                continue
        candidates = filtered
    candidates.sort(key=lambda info: info["stat"].st_mtime_ns, reverse=True)
    rows: list[dict[str, object]] = []
    for info in candidates:
        if len(rows) >= options.limit:
            break
        try:
            row = cached_scan_rollout(info, thread_index, agent_counts, cache)
        except RuntimeError as error:
            print(f"Warning: {error}", file=error_stream)
            continue
        row["rank"] = len(rows) + 1
        if open_rollouts is not None:
            try:
                liveness = "OPEN" if Path(info["path"]).resolve() in open_rollouts else "CLOSED"
            except OSError:
                liveness = "UNKNOWN"
        else:
            liveness = "UNKNOWN"
        row["liveness"] = liveness
        row["status"] = session_status(liveness, str(row["state"]))
        try:
            context = live_contexts.get(Path(info["path"]).resolve())
        except OSError:
            context = None
        row["live_pid"] = context.pid if context else None
        row["zellij_session"] = context.zellij_session if context else ""
        row["zellij_pane_id"] = context.zellij_pane_id if context else ""
        row["tmux_socket"] = context.tmux_socket if context else ""
        row["tmux_pane"] = context.tmux_pane if context else ""
        rows.append(row)
    if options.json_output:
        json.dump(rows, stream, indent=2)
        print(file=stream)
        return 0
    if not rows:
        print("No readable Codex sessions found.", file=error_stream)
        return 1
    table_rows = rows if options.include_subagents else table_rows_with_active_subagents(rows, files, open_rollouts, thread_index)
    open_subagent_count = len(table_rows) - len(rows)
    scope = "top-level and subagent rollouts" if options.include_subagents else "top-level user sessions"
    enabled_links = links_are_enabled(options, output_is_tty, force_links)
    colors_enabled = output_is_tty
    if options.include_subagents:
        summary = f"{len(rows)} shown"
    else:
        summary = f"{len(rows)} roots shown, {open_subagent_count} active subagents"
    print(f"Recent Codex {scope} (by last local activity; {summary})", file=stream)
    print(file=stream)
    render_table(table_rows, enabled_links, colors_enabled, stream)
    print(file=stream)
    print("TYPE: CLI is a terminal session, APP is a desktop or IDE session, and AGENT is a subagent. STATUS: CLOSED has no matching local Codex process; BUSY has an active task; WAITING has no active task. Nested AGENT rows follow /agent's active-thread concept: only child threads with an active latest task are shown. Completed threads held open by a Codex process are omitted. U/A is user/assistant messages; C/S/A is complete/started/aborted tasks. Nested U/A, C/S/A, and TOKENS values are unavailable without a reliable per-agent attribution. Top-level token totals are session-tree totals and include cached input. Elapsed is time in the current derived lifecycle state.", file=stream)
    if enabled_links:
        print("Clickable top-level IDs resume the session in its recorded CWD. Use --no-links or CODEX_SESSIONS_LINKS=0 for plain IDs.", file=stream)
    if options.verbose:
        render_details(rows, stream)
    return 0


