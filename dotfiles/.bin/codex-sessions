            Binding("s", "show_sessions", "Sessions", show=False),
            Binding("escape", "show_sessions", "Sessions", show=False),
        ]

        def __init__(self) -> None:
            super().__init__()
            self.theme = "tokyo-night"
            self.scroll_sensitivity_y = 1.0
            self.sessions: list[TranscriptSession] = []
            self.visible_sessions: list[TranscriptSession] = []
            self.selected: Optional[TranscriptSession] = None
            self.selected_offset = 0
            self.selected_size = 0
            self.follow = True
            self.unread_messages = 0
            self.unread_by_session: dict[str, int] = {}
            self.session_offsets: dict[str, int] = {}
            self.session_sizes: dict[str, int] = {}
            self.rendered_day = None
            self.launch_cwd = os.getcwd()
            self.layout_width = 0
            self.transcript_resize_timer = None

        def get_system_commands(self, screen):
            yield from (command for command in super().get_system_commands(screen) if command.title != "Theme")

        def compose(self) -> ComposeResult:
            with Horizontal(id="body"):
                with Vertical(id="sidebar"):
                    yield Input(placeholder="Filter sessions  /", id="session-filter", compact=True)
                    yield ListView(id="session-list")
                with Vertical(id="main"):
                    yield Static("Select a session", id="session-header")
                    yield TranscriptLog(
                        id="transcript",
                        min_width=1,
                        wrap=True,
                        highlight=False,
                        markup=False,
                        auto_scroll=True,
                        max_lines=50_000,
                    )
                    yield Static(id="transcript-empty")
            yield Static(id="footer")

        async def on_mount(self) -> None:
            self.update_responsive_mode(self.size.width)
            await self.reload_sessions()
            self.update_footer()
            self.set_interval(1.0, self.poll_selected)

        def on_resize(self, event: events.Resize) -> None:
            previous_width = self.layout_width
            self.layout_width = event.size.width
            self.update_responsive_mode(event.size.width)
            if self.selected and previous_width and previous_width != event.size.width:
                if self.transcript_resize_timer is not None:
                    self.transcript_resize_timer.stop()
                self.transcript_resize_timer = self.set_timer(0.12, self.reflow_transcript)

        def reflow_transcript(self) -> None:
            self.transcript_resize_timer = None
            if not self.selected:
                return
            log = self.query_one("#transcript", TranscriptLog)
            if log.region.width == 0:
                return
            scroll_ratio = float(log.scroll_y) / max(1.0, float(log.max_scroll_y))
            self.load_session(self.selected)
            if not self.follow:
                self.call_after_refresh(self.restore_transcript_scroll, scroll_ratio)

        def restore_transcript_scroll(self, scroll_ratio: float) -> None:
            log = self.query_one("#transcript", TranscriptLog)
            log.scroll_to(y=float(log.max_scroll_y) * scroll_ratio, animate=False)
            self.call_after_refresh(self.update_footer)

        @property
        def is_narrow(self) -> bool:
            return self.screen.has_class("narrow")

        def update_responsive_mode(self, width: int) -> None:
            narrow = width < 72
            self.screen.set_class(narrow, "narrow")
            if not narrow:
                self.screen.remove_class("show-transcript")
            if self.selected:
                self.update_session_header()
            if self.query("#footer"):
                self.update_footer()

        def update_footer(self) -> None:
            footer = Text()

            def add(key: str, label: str = "") -> None:
                if footer:
                    footer.append("  ")
                keycap = key if self.is_narrow else f" {key} "
                footer.append(keycap, style="bold #ff9e64 on #24283b")
                if label:
                    footer.append(f" {label}", style="#a9b1d6")

            follow_label = "on" if self.follow else "paused"
            if self.is_narrow:
                add("q")
                if self.screen.has_class("show-transcript"):
                    add("s", "list")
                    add("f", follow_label)
                    add("r")
                    add("g")
                else:
                    add("/", "filter")
                    add("↵", "open")
                    add("f", follow_label)
                    add("r")
            else:
                add("q", "Quit")
                add("/", "Filter")
                add("f", "Following" if self.follow else "Paused")
                add("r", "Refresh")
                add("g", "Go to pane")
            if self.unread_messages:
                if footer:
                    footer.append("  ")
                unread_label = (
                    f"↓{self.unread_messages}"
                    if self.is_narrow
                    else f"↓ {self.unread_messages} new"
                )
                footer.append(unread_label, style="bold #f7768e")
            if not self.follow and self.selected:
                log = self.query_one("#transcript", TranscriptLog)
                scroll_limit = float(log.max_scroll_y)
                scroll_percent = 100 if scroll_limit <= 0 else round(100 * float(log.scroll_y) / scroll_limit)
                if footer:
                    footer.append("  ")
                footer.append(f"{scroll_percent}%", style="bold #e0af68")
            self.query_one("#footer", Static).update(footer)

        async def reload_sessions(self) -> None:
            selected_id = self.selected.session_id if self.selected else ""
            view = self.query_one("#session-list", ListView)
            await view.clear()
            await view.append(SessionLoadingState())
            self.query_one("#session-header", Static).update("LOADING SESSIONS")
            self.show_empty_transcript("◌  LOADING SESSIONS", "Reading local Codex history")
            await asyncio.sleep(0)
            self.sessions = discover_transcript_sessions(codex_home, options.include_subagents)
            live_ids = {session.session_id for session in self.sessions if session.live}
            self.unread_by_session = {
                session_id: count
                for session_id, count in self.unread_by_session.items()
                if session_id in live_ids
            }
            for session in self.sessions:
                if not session.live or session.session_id in self.session_sizes:
                    continue
                try:
                    size = session.path.stat().st_size
                except OSError:
                    continue
                self.session_offsets[session.session_id] = size
                self.session_sizes[session.session_id] = size
            if not selected_id:
                preferred = next(
                    (session for session in self.sessions if session.live and session.cwd == self.launch_cwd),
                    None,
                )
                selected_id = preferred.session_id if preferred else ""
            focus_list = not (self.is_narrow and self.screen.has_class("show-transcript"))
            await self.populate_sessions(selected_id, focus_list=focus_list)

        @staticmethod
        def session_section(session: TranscriptSession) -> str:
            if session.live:
                return "LIVE"
            if session.archived:
                return "ARCHIVED"
            return "HISTORY"

        async def populate_sessions(self, selected_id: str = "", focus_list: bool = True) -> None:
            query = self.query_one("#session-filter", Input).value.casefold().strip()
            self.visible_sessions = [
                session
                for session in self.sessions
                if not query
                or query in session.session_id.casefold()
                or query in session.cwd.casefold()
                or query in session.title.casefold()
                or (query == "live" and session.live is not None)
            ]
            section_order = {"LIVE": 0, "HISTORY": 1, "ARCHIVED": 2}
            self.visible_sessions.sort(
                key=lambda session: (section_order[self.session_section(session)], -session.updated_at)
            )
            view = self.query_one("#session-list", ListView)
            await view.clear()
            if not self.visible_sessions:
                self.selected = None
                self.unread_messages = 0
                await view.append(SessionEmptyState())
                self.query_one("#session-header", Static).update("NO MATCHES")
                self.show_empty_transcript("◇  NO MATCHES", "Try another filter")
                self.update_footer()
                return
            items: list[ListItem] = []
            session_indexes: dict[str, int] = {}
            previous_section = ""
            for session in self.visible_sessions:
                section = self.session_section(session)
                if section != previous_section:
                    items.append(SessionSection(section))
                    previous_section = section
                session_indexes[session.session_id] = len(items)
                items.append(SessionItem(session, self.unread_by_session.get(session.session_id, 0)))
            await view.extend(items)
            selected_index = session_indexes.get(selected_id, 1)
            view.index = selected_index
            if focus_list:
                view.focus()
            selected_item = items[selected_index]
            if isinstance(selected_item, SessionItem):
                self.load_session(selected_item.session)

        @staticmethod
        def message_day_label(timestamp: float) -> str:
            message_day = datetime.fromtimestamp(timestamp).astimezone().date()
            today = datetime.now().astimezone().date()
            if message_day == today:
                return "TODAY"
            if (today - message_day).days == 1:
                return "YESTERDAY"
            return message_day.strftime("%a · %b %d, %Y").replace(" 0", " ").upper()

        def show_empty_transcript(self, title: str, hint: str) -> None:
            log = self.query_one("#transcript", TranscriptLog)
            log.clear()
            log.display = False
            empty = self.query_one("#transcript-empty", Static)
            empty.update(Text.assemble((title, "bold #7aa2f7"), (f"\n{hint}", "#8992b3")))
            empty.display = True

        def show_transcript(self) -> None:
            self.query_one("#transcript-empty", Static).display = False
            self.query_one("#transcript", TranscriptLog).display = True

        def render_message(self, message: TranscriptMessage) -> None:
            log = self.query_one("#transcript", RichLog)
            message_day = datetime.fromtimestamp(message.timestamp).astimezone().date()
            if message_day != self.rendered_day:
                self.rendered_day = message_day
                day_label = self.message_day_label(message.timestamp)
                rule_width = max(12, log.scrollable_content_region.width)
                rule_prefix = f"── {day_label} "
                date_rule = rule_prefix + "─" * max(0, rule_width - len(rule_prefix))
                log.write(Text(date_rule, style="bold #7f849c"), scroll_end=self.follow)
                log.write("", scroll_end=self.follow)
            timestamp = datetime.fromtimestamp(message.timestamp).astimezone().strftime("%H:%M:%S")
            if message.role == "user":
                accent = "#bb9af7"
                is_final = False
                label = Text.assemble((timestamp, "#8992b3"), ("  YOU", f"bold {accent}"))
            else:
                is_final = message.phase == "final_answer"
                accent = "#9ece6a" if is_final else "#7aa2f7"
                phase = " · FINAL" if is_final else " · UPDATE" if message.phase == "commentary" else ""
                label = Text.assemble(
                    (timestamp, "#8992b3"),
                    ("  CODEX", f"bold {accent}"),
                    (phase, f"bold {accent}"),
                )
            body = TranscriptMarkdown(
                message.text,
                code_theme=code_theme,
                inline_code_theme=code_theme,
                style="#c0caf5",
            )
            panel = Panel(
                Group(label, body),
                box=message_box,
                border_style=accent,
                style="#c0caf5",
                padding=(0, 1),
            )
            log.write(panel, scroll_end=self.follow)

        def set_session_unread(self, session_id: str, unread: int) -> None:
            if unread:
                self.unread_by_session[session_id] = unread
            else:
                self.unread_by_session.pop(session_id, None)
            for item in self.query(SessionItem):
                if item.session.session_id == session_id:
                    item.update_unread(unread)
                    break

        def update_session_header(self) -> None:
            session = self.selected
            if not session:
                return
            live = session.live
            location = ""
            if live and live.zellij_pane_id:
                location = f"{live.zellij_session or 'zellij'}:{live.zellij_pane_id}"
            state = "LIVE" if live else "ARCHIVED" if session.archived else "HISTORY"
            state_marker = "●" if live else "◆" if session.archived else "○"
            state_label = f"{state_marker} {state}"
            state_style = "bold #9ece6a" if live else "bold #bb9af7" if session.archived else "bold #7aa2f7"
            display_id = (
                f"{session.session_id[:8]}…{session.session_id[-4:]}"
                if len(session.session_id) > 13
                else session.session_id
            )
            sidebar_width = self.query_one("#sidebar").region.width
            header_width = self.size.width if self.is_narrow else max(1, self.size.width - sidebar_width)
            title_width = max(12, header_width - len(state_label) - 6)
            elapsed = ""
            if session.started_at:
                elapsed_end = time.time() if live else session.updated_at
                elapsed = f"{duration_text(max(0, elapsed_end - session.started_at))} elapsed"
            details = header_details(
                relative_cwd(session.cwd) if session.cwd else "",
                [
                    f"git:{session.git_branch}" if session.git_branch else "",
                    session.model,
                    f"{session.reasoning_effort} reasoning" if session.reasoning_effort else "",
                    elapsed,
                    location,
                    display_id,
                ],
                max(12, header_width - 4),
            )
            header = Text.assemble(
                (state_label, state_style),
                ("  ", ""),
                (compact_text(session.title, title_width), "bold #c0caf5"),
                (f"\n{details}", "#8992b3"),
            )
            self.query_one("#session-header", Static).update(header)

        def load_session(self, session: TranscriptSession) -> None:
            self.selected = session
            log = self.query_one("#transcript", RichLog)
            log.clear()
            self.rendered_day = None
            messages, self.selected_offset = read_transcript(session.path)
            try:
                self.selected_size = session.path.stat().st_size
            except OSError:
                self.selected_size = self.selected_offset
            self.session_offsets[session.session_id] = self.selected_offset
            self.session_sizes[session.session_id] = self.selected_size
            self.update_session_header()
            if not messages:
                self.show_empty_transcript("◇  NO MESSAGES YET", "Waiting for user or Codex activity")
                return
            self.show_transcript()
            for message in messages:
                self.render_message(message)
            if self.follow:
                log.scroll_end(animate=False)

        def poll_selected(self) -> None:
            session = self.selected
            if not session:
                return
            for candidate in self.sessions:
                if not candidate.live or candidate.session_id == session.session_id:
                    continue
                try:
                    candidate_size = candidate.path.stat().st_size
                except OSError:
                    continue
                candidate_id = candidate.session_id
                previous_size = self.session_sizes.get(candidate_id)
                if previous_size is None:
                    self.session_offsets[candidate_id] = candidate_size
                    self.session_sizes[candidate_id] = candidate_size
                    continue
                if candidate_size == previous_size:
                    continue
                candidate_offset = self.session_offsets.get(candidate_id, previous_size)
                if candidate_size < previous_size:
                    self.session_offsets[candidate_id] = candidate_size
                    self.session_sizes[candidate_id] = candidate_size
                    self.set_session_unread(candidate_id, 0)
                    continue
                messages, new_offset = read_transcript(candidate.path, candidate_offset)
                self.session_offsets[candidate_id] = new_offset
                self.session_sizes[candidate_id] = candidate_size
                if messages:
                    self.set_session_unread(
                        candidate_id,
                        self.unread_by_session.get(candidate_id, 0) + len(messages),
                    )
            if session.live:
                self.update_session_header()
            try:
                size = session.path.stat().st_size
            except OSError:
                return
            if size == self.selected_size:
                return
            if size < self.selected_offset:
                self.load_session(session)
                return
            messages, new_offset = read_transcript(session.path, self.selected_offset)
            self.selected_offset = new_offset
            self.selected_size = size
            self.session_offsets[session.session_id] = new_offset
            self.session_sizes[session.session_id] = size
            if messages:
                self.show_transcript()
                if not self.follow:
                    self.unread_messages += len(messages)
                    self.set_session_unread(
                        session.session_id,
                        self.unread_by_session.get(session.session_id, 0) + len(messages),
                    )
                    self.update_footer()
            for message in messages:
                self.render_message(message)

        def on_list_view_highlighted(self, event: ListView.Highlighted) -> None:
            if isinstance(event.item, SessionItem):
                self.unread_messages = 0
                self.set_session_unread(event.item.session.session_id, 0)
                self.load_session(event.item.session)
                self.update_footer()

        def on_list_view_selected(self, event: ListView.Selected) -> None:
            if isinstance(event.item, SessionItem):
                self.unread_messages = 0
                self.set_session_unread(event.item.session.session_id, 0)
                self.load_session(event.item.session)
                if self.is_narrow:
                    self.screen.add_class("show-transcript")
                    self.query_one("#transcript", TranscriptLog).focus()
                    self.update_footer()
                    # The transcript was hidden (zero width) while it loaded; wrap it again
                    # once the narrow layout shows it.
                    self.call_after_refresh(self.reflow_transcript)

        async def on_input_changed(self, event: Input.Changed) -> None:
            if event.input.id == "session-filter":
                await self.populate_sessions(self.selected.session_id if self.selected else "", focus_list=False)

        def on_input_submitted(self, event: Input.Submitted) -> None:
            if event.input.id == "session-filter":
                self.query_one("#session-list", ListView).focus()

        def action_focus_filter(self) -> None:
            self.action_show_sessions()
            self.query_one("#session-filter", Input).focus()

        def set_follow(self, enabled: bool) -> None:
            self.follow = enabled
            self.screen.set_class(not enabled, "follow-paused")
            if enabled:
                self.unread_messages = 0
                if self.selected:
                    self.set_session_unread(self.selected.session_id, 0)
            log = self.query_one("#transcript", RichLog)
            log.auto_scroll = self.follow
            if self.follow:
                log.scroll_end(animate=False)
            self.update_footer()

        def action_toggle_follow(self) -> None:
            self.set_follow(not self.follow)
            self.notify(f"Follow {'on' if self.follow else 'off'}")

        def action_show_sessions(self) -> None:
            if self.is_narrow:
                self.screen.remove_class("show-transcript")
            self.query_one("#session-list", ListView).focus()
            self.update_footer()

        async def action_refresh_sessions(self) -> None:
            await self.reload_sessions()
            self.notify(f"Refreshed {len(self.sessions)} sessions")

        def action_goto_pane(self) -> None:
            live = self.selected.live if self.selected else None
            if not live or not live.zellij_pane_id:
                self.notify("This session has no live Zellij pane", severity="warning")
                return
            zellij = shutil.which("zellij")
            if not zellij:
                self.notify("zellij is unavailable", severity="error")
                return
            environment = dict(os.environ)
            if live.zellij_session:
                environment["ZELLIJ_SESSION_NAME"] = live.zellij_session
            pane_id = live.zellij_pane_id
            if pane_id.isdigit():
                pane_id = f"terminal_{pane_id}"
            try:
                completed = subprocess.run(
                    [zellij, "action", "focus-pane-id", pane_id],
                    capture_output=True,
                    text=True,
                    timeout=5,
                    check=False,
                    env=environment,
                )
            except (OSError, subprocess.TimeoutExpired) as error:
                self.notify(str(error), severity="error")
                return
            if completed.returncode:
                self.notify(completed.stderr.strip() or "Could not focus pane", severity="error")

    return CodexTranscriptApp()


def run_tui(options: ReportOptions) -> int:
    try:
        app = build_tui_app(options)
    except RuntimeError as error:
        print(f"Error: {error}", file=sys.stderr)
        return 1
    app.run()
    return 0


def watch(options: ReportOptions) -> int:
    arguments = "".join(f" {shlex.quote(argument)}" for argument in options.display_args)
    last_size: Optional[os.terminal_size] = None
    first_frame = True
    cache = ReportCache(rows={})
    sys.stdout.write("\033[?25l")
    sys.stdout.flush()
    try:
        while True:
            size = shutil.get_terminal_size((0, 0))
            resized = first_frame or size != last_size
            last_size = size
            first_frame = False
            captured = io.StringIO()
            rc = report(
                options,
                captured,
                captured,
                True,
                force_links=not options.no_links and os.environ.get("CODEX_SESSIONS_LINKS") != "0",
                cache=cache,
            )
            prefix = "\033[?2026h\033[H" + ("\033[2J\033[3J" if resized else "\033[2K")
            frame = f"{prefix}Every {options.interval}s: codex-sessions{arguments}    {time.ctime()}\033[K\n\033[K\n"
            frame += captured.getvalue().replace("\n", "\033[K\n") + "\033[K\n"
            if rc:
                frame += f"\033[K\nExit status: {rc}\033[K\n"
            sys.stdout.write(frame + "\033[J\033[?2026l")
            sys.stdout.flush()
            time.sleep(options.interval)
    except KeyboardInterrupt:
        return 130
    finally:
        sys.stdout.write("\033[?25h")
        sys.stdout.flush()


