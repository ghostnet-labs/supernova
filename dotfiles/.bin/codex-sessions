    class SessionLabel:
        def __init__(self, session: TranscriptSession, unread: int = 0) -> None:
            self.session = session
            self.unread = unread

        def __rich_console__(self, console, render_options):
            session = self.session
            width = max(1, render_options.max_width)
            marker = "●" if session.live else "◆" if session.archived else "○"
            marker_style = "bold #9ece6a" if session.live else "#bb9af7" if session.archived else "#a9b1d6"
            timestamp = compact_local_time(session.updated_at)
            cwd = relative_cwd(session.cwd)
            cwd = Path(cwd).name if cwd not in {"-", "~"} else cwd
            cwd_width = max(1, width - len(timestamp) - 3)
            first_line = Text.assemble(
                (f"{marker} ", marker_style),
                (compact_text(cwd, cwd_width), "bold #c0caf5"),
            )
            first_line.append(" " * max(1, width - first_line.cell_len - len(timestamp)))
            first_line.append(timestamp, style="#a9b1d6")
            yield first_line
            badge_count = str(self.unread) if self.unread < 100 else "99+"
            badge = f"●{badge_count}" if self.unread else ""
            title_width = max(1, width - len(badge) - (1 if badge else 0))
            title = Text(compact_text(session.title, title_width), style="#a9b1d6")
            if badge:
                title.append(" " * max(1, width - title.cell_len - len(badge)))
                title.append(badge, style="bold #f7768e")
            yield title

