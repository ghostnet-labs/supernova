def install_resume_handler(force: bool) -> int:
    if sys.platform != "darwin":
        print("Error: --install-resume-handler is supported only on macOS.", file=sys.stderr)
        return 1
    clang = shutil.which("clang")
    if not clang:
        print("Error: clang is required. Install Xcode Command Line Tools first.", file=sys.stderr)
        return 1
    if not LSREGISTER.is_file() or not os.access(LSREGISTER, os.X_OK):
        print("Error: macOS LaunchServices registration tool was not found.", file=sys.stderr)
        return 1
    app_dir = Path.home() / "Applications" / APP_NAME
    if app_dir.exists() and not force:
        print(f"Error: {app_dir} already exists; re-run with --force to replace it.", file=sys.stderr)
        return 1
    source = Path(__file__).resolve()
    if not source.is_file():
        print(f"Error: cannot locate the standalone script at {source}", file=sys.stderr)
        return 1
    with tempfile.TemporaryDirectory(prefix="codex-resume.") as temporary:
        build_dir = Path(temporary)
        handler = build_dir / "codex-resume-handler.m"
        binary = build_dir / "CodexResume"
        handler.write_text(HANDLER_SOURCE, encoding="utf-8")
        try:
            subprocess.run([clang, "-fobjc-arc", "-framework", "AppKit", str(handler), "-o", str(binary)], check=True)
        except subprocess.CalledProcessError as error:
            print(f"Error: failed to build the resume handler: {error}", file=sys.stderr)
            return error.returncode or 1
        staged_app = build_dir / APP_NAME
        resources = staged_app / "Contents" / "Resources"
        resources.mkdir(parents=True)
        macos_dir = staged_app / "Contents" / "MacOS"
        macos_dir.mkdir()
        shutil.move(str(binary), macos_dir / "CodexResume")
        launcher = resources / "codex-sessions"
        shutil.copy2(source, launcher)
        launcher.chmod(launcher.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
        (staged_app / "Contents" / "Info.plist").write_text(INFO_PLIST, encoding="utf-8")
        app_dir.parent.mkdir(parents=True, exist_ok=True)
        if app_dir.exists():
            shutil.rmtree(app_dir)
        shutil.move(str(staged_app), app_dir)
    subprocess.run([str(LSREGISTER), "-f", str(app_dir)], check=True)
    print(f"Installed and registered {app_dir}")
    print("Run codex-sessions from tmux, then Command-click a session ID to resume it in a right-side pane.")
    return 0


def fail_resume(message: str) -> None:
    print(f"codex-sessions: {message}", file=sys.stderr)
    raise SystemExit(1)


def command_path(name: str) -> str:
    path = shutil.which(name)
    if not path:
        fail_resume(f"{name} is not on PATH")
    return path


def validate_socket(socket_text: str) -> Path:
    uid = os.getuid()
    prefixes = (f"/private/tmp/tmux-{uid}/", f"/tmp/tmux-{uid}/")
    if not socket_text.startswith(prefixes):
        fail_resume("tmux socket is outside this user's tmux directory")
    socket_path = Path(socket_text)
    try:
        socket_stat = socket_path.stat()
    except OSError:
        fail_resume("tmux socket is unavailable")
    if not stat.S_ISSOCK(socket_stat.st_mode) or socket_stat.st_uid != uid:
        fail_resume("tmux socket is not an owned socket")
    return socket_path


def parse_resume_url(raw_url: str) -> tuple[str, Path, str, str]:
    parsed = urlparse(raw_url)
    if parsed.scheme != "codex-resume" or parsed.netloc != "resume" or parsed.path:
        fail_resume("invalid Codex resume URL")
    try:
        pairs = parse_qsl(parsed.query, keep_blank_values=True, strict_parsing=True)
    except ValueError:
        fail_resume("invalid URL query")
    query: dict[str, str] = {}
    for key, value in pairs:
        if key in query:
            fail_resume(f"duplicate URL field: {key}")
        query[key] = value
    expected = {"session", "cwd", "tmux_socket", "tmux_pane"}
    if set(query) - expected or not {"session", "cwd"}.issubset(query):
        fail_resume("URL is missing required session information")
    try:
        session_id = str(UUID(query["session"]))
    except (KeyError, ValueError):
        fail_resume("invalid session UUID")
    cwd = Path(query["cwd"])
    if not cwd.is_absolute() or not cwd.is_dir():
        fail_resume(f"recorded working directory is unavailable: {cwd}")
    return session_id, cwd, query.get("tmux_socket", ""), query.get("tmux_pane", "")


def launch_resume(raw_url: str) -> int:
    session_id, cwd, tmux_socket, tmux_pane = parse_resume_url(raw_url)
    os.environ["PATH"] = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
    codex = command_path("codex")
    shell = os.environ.get("SHELL", "/bin/zsh")
    if not os.path.isfile(shell) or not os.access(shell, os.X_OK):
        shell = "/bin/zsh"
    resume_command = f"cd {shlex.quote(str(cwd))} && exec {shlex.quote(codex)} resume {shlex.quote(session_id)}"
    if tmux_socket or tmux_pane:
        if not tmux_socket or not tmux_pane:
            fail_resume("incomplete tmux target")
        if not re.fullmatch(r"%[0-9]+", tmux_pane):
            fail_resume("invalid tmux pane")
        tmux = command_path("tmux")
        validate_socket(tmux_socket)
        pane_command = f"{shlex.quote(shell)} -lc {shlex.quote(resume_command)}"
        subprocess.run([tmux, "-S", tmux_socket, "split-window", "-h", "-t", tmux_pane, "-c", str(cwd), pane_command], check=True)
        return 0
    subprocess.run(["/usr/bin/open", "-na", "Ghostty.app", "--args", "--window-save-state=never", f"--working-directory={cwd}", f"--initial-command={shlex.quote(shell)} -lic {shlex.quote(resume_command)}"], check=True)
    return 0


def show_terminal(pid: int, cwd: str) -> None:
    """Raise the exact Ghostty window/tab/split showing PID, or at least Ghostty."""
    if sys.platform != "darwin":
        return
    helper = Path(__file__).resolve().with_name("ghostty-focus")
    found = None
    if pid:
        try:
            found = subprocess.run([str(helper), "--pid", str(pid), "--cwd", cwd], capture_output=True, timeout=10, check=False)
        except (OSError, subprocess.TimeoutExpired):
            found = None
    if not found or found.returncode:
        subprocess.run(["/usr/bin/open", "-a", "Ghostty"], check=False)


def jump_to_session(session_id: str) -> int:
    """Focus a live multiplexer pane for SESSION_ID, or resume it in Ghostty."""
    codex_home = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))
    sessions = discover_transcript_sessions(codex_home, include_subagents=True)
    session = next((candidate for candidate in sessions if candidate.session_id == session_id), None)
    if not session:
        fail_resume(f"session not found: {session_id}")
    live = session.live
    if live and live.zellij_pane_id:
        zellij = command_path("zellij")
        environment = dict(os.environ)
        if live.zellij_session:
            environment["ZELLIJ_SESSION_NAME"] = live.zellij_session
        pane_id = live.zellij_pane_id
        if pane_id.isdigit():
            pane_id = f"terminal_{pane_id}"
        completed = subprocess.run(
            [zellij, "action", "focus-pane-id", pane_id],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
            env=environment,
        )
        if completed.returncode:
            fail_resume(completed.stderr.strip() or "could not focus Zellij pane")
        show_terminal(live.pid, session.cwd)
        return 0
    if live and live.tmux_socket and live.tmux_pane:
        tmux = command_path("tmux")
        validate_socket(live.tmux_socket)
        completed = subprocess.run(
            [tmux, "-S", live.tmux_socket, "select-window", "-t", live.tmux_pane, ";", "select-pane", "-t", live.tmux_pane],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        if completed.returncode:
            fail_resume(completed.stderr.strip() or "could not focus tmux pane")
        show_terminal(live.pid, session.cwd)
        return 0
    if live:
        # A background app-server can retain the rollout after its TUI exits.
        # Only focus it when an actual terminal remains attached.
        tty = subprocess.run(["ps", "-p", str(live.pid), "-o", "tty="], capture_output=True, text=True, check=False)
        if tty.returncode == 0 and tty.stdout.strip() not in {"", "??", "-", "?"}:
            show_terminal(live.pid, session.cwd)
            return 0
    cwd = Path(session.cwd)
    if not cwd.is_dir():
        fail_resume(f"recorded working directory is unavailable: {cwd}")
    codex = command_path("codex")
    shell = os.environ.get("SHELL", "/bin/zsh")
    resume_command = f"cd {shlex.quote(str(cwd))} && exec {shlex.quote(codex)} resume {shlex.quote(session_id)}"
    if sys.platform == "darwin":
        subprocess.run(["/usr/bin/open", "-na", "Ghostty.app", "--args", "--window-save-state=never", f"--working-directory={cwd}", f"--initial-command={shlex.quote(shell)} -lic {shlex.quote(resume_command)}"], check=True)
        return 0
    return subprocess.run([codex, "resume", session_id], cwd=cwd, check=False).returncode


def stream_snapshots(options: ReportOptions) -> int:
    home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
    transcripts = JsonlCache.persistent("codex", home)
    metadata_cache = {}

    def snapshot():
        if not home.is_dir():
            return {"health": "unavailable", "sessions": [], "active_subagents": []}
        files = []
        retained = set()
        for directory, archived in ((home / "sessions", False), (home / "archived_sessions", True)):
            for path in directory.rglob("rollout-*.jsonl"):
                stat = path.stat()
                retained.add(path)
                stamp = (stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns)
                previous = metadata_cache.get(path)
                # Metadata is immutable during appends, but replacement/truncation resets it.
                append = previous and previous[0][:2] == stamp[:2] and stamp[2] > previous[0][2]
                metadata = previous[1] if previous and (previous[0] == stamp or append) and previous[1] else read_metadata(path)
                metadata_cache[path] = (stamp, metadata)
                if metadata:
                    files.append({"path": path, "stat": stat, "metadata": metadata, "archived": archived})
        index = load_thread_index(home / "state_5.sqlite")
        live = live_rollouts(home / "sessions", strict=True)
        counts = Counter(str(info["metadata"].get("session_id")) for info in files if info["metadata"].get("thread_source") == "subagent")
        roots, agents = {}, {}
        for info in files:
            row = scan_rollout(info, index, counts, transcripts)
            path = info["path"]
            context = live.get(path.resolve())
            if row["title"] == "-":
                row["title"] = " ".join(str(row["first_user_request"]).split())[:180] if row["first_user_request"] != "-" else row["session_id"]
            row.update(file_metadata(path))
            row.update(transcript_path=str(path), archived=info["archived"], context_window_is_estimated=False,
                       liveness="OPEN" if context else "CLOSED", live_pid=context.pid if context else None,
                       tmux_socket=context.tmux_socket if context else "", tmux_pane=context.tmux_pane if context else "",
                       zellij_session=context.zellij_session if context else "", zellij_pane_id=context.zellij_pane_id if context else "")
            row["status"] = session_status(row["liveness"], str(row["state"]))
            if context and row["state"] == "aborted":
                row["status"] = "INTERRUPTED"
            if info["metadata"].get("thread_source") != "user":
                if context and row["state"] == "open":
                    row["table_detail"] = agent_task_label(info["metadata"], index.get(row["session_id"], {}))
                    agents[row["session_id"]] = row
            else:
                previous = roots.get(row["session_id"])
                if not previous or (previous["archived"] and not row["archived"]) or previous["last_activity"] < row["last_activity"]:
                    roots[row["session_id"]] = row
        transcripts.retain(retained)
        for path in set(metadata_cache) - retained:
            del metadata_cache[path]
        return {"health": "ok", "sessions": sorted(roots.values(), key=lambda row: row["last_activity"], reverse=True),
                "active_subagents": list(agents.values())}

    return run_stream("codex", options.interval, snapshot)


def main(argv: list[str]) -> int:
    if argv[:1] == ["--jump"]:
        if len(argv) != 2:
            fail_resume("usage: codex-sessions --jump SESSION_ID")
        return jump_to_session(argv[1])
    if argv[:1] == ["--resume-url"]:
        if len(argv) != 2:
            fail_resume("usage: codex-sessions --resume-url <codex-resume-url>")
        return launch_resume(argv[1])
    if "--install-resume-handler" in argv:
        allowed = {"--install-resume-handler", "--force"}
        if any(argument not in allowed for argument in argv):
            raise UsageError("--install-resume-handler accepts only --force")
        return install_resume_handler("--force" in argv)
    options = parse_report_options(argv)
    if options.stream_json:
        return stream_snapshots(options)
    if options.tui:
        return run_tui(options)
    return watch(options) if options.watch else report(options, sys.stdout, sys.stderr, sys.stdout.isatty())


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except UsageError as error:
        print(error, file=sys.stderr)
        build_help_parser().print_usage(file=sys.stderr)
        raise SystemExit(1)
