#!/usr/bin/env bash
# toolbox: macos setup apps | Rebuild, reinstall, and restart all managed macOS apps or selected apps.
# toolbox-args: [APP...]
# toolbox-example: reinstall-apps agent-workspace
# toolbox-example: reinstall-apps agent-workspace setup-doctor
# toolbox-example: reinstall-apps
# toolbox-example: reinstall-apps --stale
# Rebuild, reinstall, and restart every macOS app under apps/.

set -euo pipefail

usage() {
  printf '%s\n' 'Usage:
  reinstall-apps [--stale] [--list] [APP...]

Description:
  Rebuild every macOS app under apps/ (each directory with an Info.plist) and
  restart it on the new build by running each app'\''s own --install, all in
  parallel. An install quits the running copy only after its build succeeds,
  so a failed build leaves the old copy running and its log is printed. The
  Zellij plugin sources (zellij-tab-picker, zj-radar) are not macOS apps and
  are skipped. Exits 1 if any app fails. With a work overlay (WORK_ROOT and
  JOB exported by .zshrc), apps under WORK_ROOT/apps are included too; their
  installers live in WORK_ROOT/JOB/bin-JOB.

  Each successful install records the committed source it was built from (its
  apps/ directory, apps/lib, and its installer) in .local/app-builds/. --stale
  rebuilds only apps whose committed source has changed since, or that have no
  record yet.

Options:
  APP           Reinstall only this app, named by its apps/ directory
                (default: every app).
  --stale       Rebuild only apps whose source changed since their last install.
  --list        Print each app and its installer instead of reinstalling.
  -h, --help    Show this help message and exit.

Examples:
  reinstall-apps
  reinstall-apps --list
  reinstall-apps --stale
  reinstall-apps --stale --list
  reinstall-apps agent-workspace
  reinstall-apps agent-workspace setup-doctor

Environment:
  WORK_ROOT, JOB  Work overlay checkout and job whose apps are also rebuilt.'
}

list=false
stale=false
apps=()
for arg in "$@"; do
  case "$arg" in
    -h | --help) usage; exit 0 ;;
    --list) list=true ;;
    --stale) stale=true ;;
    -*) printf 'error: unknown option: %s\n' "$arg" >&2; usage >&2; exit 2 ;;
    *) apps+=("$arg") ;;
  esac
done

if [[ "$list" != true && "$(uname -s)" != Darwin ]]; then
  printf 'error: reinstall-apps requires macOS\n' >&2
  exit 1
fi

bin_dir="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
readonly bin_dir
# Each source pairs an apps directory with the directory of its installers.
app_dirs=("$(cd -- "$bin_dir/../../apps" && pwd)")
bin_dirs=("$bin_dir")
lib_dir="${app_dirs[0]}/lib"
builds="${app_dirs[0]}/../.local/app-builds"
if [[ -n "${WORK_ROOT:-}" && -n "${JOB:-}" && -d "$WORK_ROOT/apps" ]]; then
  app_dirs+=("$WORK_ROOT/apps")
  bin_dirs+=("$WORK_ROOT/$JOB/bin-$JOB")
fi

# source_of PATH... prints the committed Git object of each path ("none" for a
# path that doesn't exist), or nothing when an existing path isn't committed, so
# such an app always counts as stale.
source_of() {
  local path ids=() id
  for path in "$@"; do
    if [[ ! -e "$path" ]]; then ids+=(none); continue; fi
    id="$(git -C "$(dirname -- "$path")" rev-parse --verify --quiet "HEAD:./$(basename -- "$path")" 2>/dev/null)" || return 0
    ids+=("$id")
  done
  printf '%s\n' "${ids[*]}"
}

# An app's installer is the command of the same name in its bin directory, or
# NAME-app when a CLI already has the bare name.
names=()
commands=()
sources=()
selected=" ${apps[*]-} "
for i in "${!app_dirs[@]}"; do
  for plist in "${app_dirs[i]}"/*/Info.plist; do
    [[ -f "$plist" ]] || continue
    name="${plist%/Info.plist}"
    name="${name##*/}"
    if ((${#apps[@]})) && [[ "$selected" != *" $name "* ]]; then continue; fi
    command="${bin_dirs[i]}/$name-app"
    [[ -x "$command" ]] || command="${bin_dirs[i]}/$name"
    if [[ ! -x "$command" ]]; then
      printf 'error: no installer in %s for %s\n' "${bin_dirs[i]}" "${plist%/Info.plist}" >&2
      exit 1
    fi
    names+=("$name")
    commands+=("$command")
    sources+=("$(source_of "${app_dirs[i]}/$name" "$lib_dir" "$command")")
  done
done
for name in ${apps[@]+"${apps[@]}"}; do
  if [[ " ${names[*]-} " != *" $name "* ]]; then
    printf 'error: not a managed macOS app: %s\n' "$name" >&2
    exit 2
  fi
done
if ((${#names[@]} == 0)); then
  printf 'error: no macOS apps found under %s\n' "${app_dirs[*]}" >&2
  exit 1
fi
if [[ "$stale" == true ]]; then
  total=${#names[@]}
  keep=()
  for i in "${!names[@]}"; do
    recorded="$(cat -- "$builds/${names[i]}" 2>/dev/null || true)"
    if [[ -z "${sources[i]}" || "$recorded" != "${sources[i]}" ]]; then keep+=("$i"); fi
  done
  stale_names=() stale_commands=() stale_sources=()
  for i in ${keep[@]+"${keep[@]}"}; do
    stale_names+=("${names[i]}") stale_commands+=("${commands[i]}") stale_sources+=("${sources[i]}")
  done
  names=(${stale_names[@]+"${stale_names[@]}"})
  commands=(${stale_commands[@]+"${stale_commands[@]}"})
  sources=(${stale_sources[@]+"${stale_sources[@]}"})
  if ((${#names[@]} == 0)); then
    [[ "$list" == true ]] || printf 'All %d apps match their source\n' "$total"
    exit 0
  fi
fi
if [[ "$list" == true ]]; then
  for i in "${!names[@]}"; do
    printf '%s\t%s\n' "${names[i]}" "${commands[i]}"
  done
  exit 0
fi

ok='✓' bad='✗'
if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != dumb ]]; then
  ok=$'\e[32m✓\e[0m' bad=$'\e[31m✗\e[0m'
fi

# record NAME SOURCE notes the source a successful install was built from.
record() {
  [[ -n "$2" ]] || return 0
  mkdir -p -- "$builds" && printf '%s\n' "$2" >"$builds/$1.tmp" && mv -f -- "$builds/$1.tmp" "$builds/$1"
}

logs="$(mktemp -d "${TMPDIR:-/tmp}/reinstall-apps.XXXXXX")"
trap 'rm -rf -- "$logs"' EXIT
printf '→ Rebuilding %d apps in parallel\n' "${#names[@]}"
started=$SECONDS
pids=()
for i in "${!names[@]}"; do
  # Each job prints its own row, so rows appear in the order builds finish.
  (
    if "${commands[i]}" --install </dev/null >"$logs/${names[i]}" 2>&1; then
      record "${names[i]}" "${sources[i]}"
      printf '%s %s (%ds)\n' "$ok" "${names[i]}" "$((SECONDS - started))"
    else
      printf '%s %s (%ds)\n' "$bad" "${names[i]}" "$((SECONDS - started))"
      exit 1
    fi
  ) &
  pids+=("$!")
done

failed=()
for i in "${!pids[@]}"; do
  wait "${pids[i]}" || failed+=("${names[i]}")
done

if ((${#failed[@]})); then
  for name in "${failed[@]}"; do
    printf '\n── %s\n' "$name"
    cat -- "$logs/$name"
  done
  printf '\n%s %d of %d apps failed: %s\n' "$bad" "${#failed[@]}" "${#names[@]}" "${failed[*]}"
  exit 1
fi
printf '\n%s Reinstalled %d apps in %ds\n' "$ok" "${#names[@]}" "$((SECONDS - started))"
